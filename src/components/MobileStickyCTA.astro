---
/**
 * Phone-only booking bar pinned to the bottom of the screen.
 *
 * Shows once the hero's own button has scrolled away and hides again while
 * any [data-hide-sticky] section (the closing CTA, the footer) is on screen,
 * so there are never two booking buttons in view at once.
 *
 * Reports `book_call_sticky_mobile` via the shared data-book handler.
 */
import { CALENDLY_URL } from '../lib/site';

export interface Props {
  /** CSS selector for the element whose exit reveals the bar. */
  after?: string;
}

const { after = '[data-sticky-after]' } = Astro.props;
---
<div class="sticky-cta" data-sticky-cta data-after={after} aria-hidden="true">
  <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" data-book="book_call_sticky_mobile" tabindex="-1">
    <span class="dot" aria-hidden="true"></span>
    Book a Free Call
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const link = bar?.querySelector('a');
  const anchor = bar ? document.querySelector(bar.dataset.after || '') : null;
  const hiders = [...document.querySelectorAll('[data-hide-sticky], .site-footer')];

  if (bar && link && anchor && 'IntersectionObserver' in window) {
    let pastAnchor = false;
    const hiding = new Set<Element>();
    const render = () => {
      const show = pastAnchor && hiding.size === 0;
      bar.classList.toggle('is-visible', show);
      bar.setAttribute('aria-hidden', String(!show));
      link.tabIndex = show ? 0 : -1;
    };

    new IntersectionObserver(([e]) => {
      pastAnchor = !e.isIntersecting && e.boundingClientRect.top < 0;
      render();
    }).observe(anchor);

    const hideObs = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? hiding.add(e.target) : hiding.delete(e.target)));
      render();
    });
    hiders.forEach((h) => hideObs.observe(h));
  }
</script>

<style>
  .sticky-cta {
    display: none;
  }

  @media (max-width: 768px) {
    .sticky-cta {
      display: block;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      z-index: 90;
      transform: translateY(140%);
      transition: transform 0.5s var(--ease-out);
    }

    .sticky-cta.is-visible { transform: none; }

    .sticky-cta a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 1rem 1.25rem;
      border-radius: 999px;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 1.02rem;
      color: #FFFFFF;
      text-decoration: none;
      background: var(--c-navy);
      box-shadow: 0 10px 30px rgba(15, 33, 69, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    }

    /* A small live dot: reads as "available now" without making a claim. */
    /* The ring is a pseudo-element scaled and faded with transform/opacity,
       which the GPU runs on its own; animating box-shadow repainted every
       frame and was flagged by PageSpeed. */
    .dot {
      position: relative;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #5BD49A;
    }

    .dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: rgba(91, 212, 154, 0.55);
      animation: pulse 2s ease-out infinite;
    }

    @keyframes pulse {
      from { transform: scale(1); opacity: 1; }
      to { transform: scale(3.5); opacity: 0; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta { transition: none; }
    .dot::after { animation: none; }
  }
</style>
