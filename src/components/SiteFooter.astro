---
/**
 * The one site footer. Replaces the copy that used to live in every page.
 * Contact details match the business schema in Layout.astro.
 */
import InstagramLink from './InstagramLink.astro';
import { SERVICE_LINKS, NAV_LINKS, CALENDLY_URL } from '../lib/site';
---
<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Shockwave Studios home">
        <img src="/shockwave-studios/logo.svg" alt="Shockwave Studios" width="192" height="128" loading="lazy" />
      </a>
      <p class="footer-tagline">Video marketing and video production for local businesses in Melbourne, Florida.</p>
      <InstagramLink />
    </div>

    <div class="footer-col">
      <p class="footer-heading">Services</p>
      <ul>
        {SERVICE_LINKS.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/videography/">Video Packages</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-heading">Studio</p>
      <ul>
        {NAV_LINKS.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-heading">Talk to Ashton</p>
      <ul>
        <li><a href="tel:+13213911515">321-391-1515</a></li>
        <li><a href="mailto:shockwavestudios.co@gmail.com">shockwavestudios.co@gmail.com</a></li>
        <li><a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" data-book="book_call_footer">Book a Free Call</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-base">
    <p>&copy; {new Date().getFullYear()} Shockwave Studios. Melbourne, Florida.</p>
  </div>
</footer>

<style>
  /* :where() keeps these resets at zero specificity so every real rule wins. */
  :where(.site-footer, .site-footer *) { box-sizing: border-box; margin: 0; padding: 0; }
  :where(.site-footer ul) { list-style: none; }
  :where(.site-footer a) { color: inherit; text-decoration: none; }

  .site-footer {
    background: var(--c-bg);
    color: var(--c-text);
    font-family: var(--font-body);
    border-top: 1px solid var(--c-line);
    padding: 4rem 5% 1.5rem;
  }

  .footer-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: 2.5rem;
  }

  .footer-logo {
    display: block;
    height: 72px;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }
  .footer-logo img { height: 150px; width: auto; margin: -39px 0 0 -38px; display: block; }

  .footer-tagline {
    max-width: 30ch;
    font-weight: 500;
    line-height: 1.6;
    color: var(--c-muted);
    margin-bottom: 1.25rem;
  }

  .footer-heading {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--c-navy);
    margin-bottom: 1rem;
  }

  .footer-col ul { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-col a {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--c-text);
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1.5px;
    transition: background-size 0.35s var(--ease-out), color 0.25s ease;
    padding-bottom: 2px;
    overflow-wrap: anywhere;
  }
  .footer-col a:hover, .footer-col a:focus-visible { background-size: 100% 1.5px; color: var(--c-navy); }

  .footer-base {
    max-width: 1200px;
    margin: 3rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line);
    font-size: 0.85rem;
    color: var(--c-muted);
  }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
