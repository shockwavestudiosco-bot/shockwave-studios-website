---
export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = "/og-image.jpg", noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://shockwavestudios.co/#business",
  name: "Shockwave Studios",
  description: "Social media marketing and video production for local businesses in Melbourne, Florida.",
  url: "https://shockwavestudios.co",
  image: "https://shockwavestudios.co/og-image.jpg",
  logo: "https://shockwavestudios.co/shockwave-studios/logo.svg",
  telephone: "+1-321-391-1515",
  email: "shockwavestudios.co@gmail.com",
  priceRange: "$$",
  founder: { "@type": "Person", name: "Ashton Shock" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Melbourne",
    addressRegion: "FL",
    addressCountry: "US",
  },
  areaServed: [
    { "@type": "City", name: "Melbourne, Florida" },
    { "@type": "AdministrativeArea", name: "Brevard County, Florida" },
  ],
  knowsAbout: [
    "Social media marketing",
    "Short-form video production",
    "Lead generation",
    "Content strategy",
  ],
  sameAs: ["https://www.instagram.com/shockwave.studios/"],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

  <!-- Google tag (gtag.js), only in production builds so dev traffic isn't counted -->
  {import.meta.env.PROD && (
    <Fragment>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KKWP3B4J4X"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-KKWP3B4J4X');
      </script>
    </Fragment>
  )}
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}

  <link rel="canonical" href={canonicalURL} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!--
    Three roles, one request.

      Archivo Black  impact   h1, pull statements. Ships a single weight (400),
                              so never ask for 700/800 or the browser fakes it.
      Newsreader     editorial h2/h3, prices, numerals, and every italic accent
                              line. Variable optical size, so it retunes itself
                              between a 30px heading and a 13px label.
      Inter          body     paragraphs and UI labels.

    Dropped here: Bebas Neue (loaded on every page, never used once) and
    Playfair Display (replaced by Newsreader, whose strokes survive the video
    compression these pages get screen-shared through). Monument Extended and
    its local OTFs are gone too, which retires the personal-use licence.
  -->
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..800;1,6..72,400..800&display=swap" rel="stylesheet" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
</head>
<body>
  <slot />
</body>

<style is:global>
  /*
    The type system, defined once. Pages used to repeat a @font-face block each,
    ten copies of the same thing; these three variables replace all of that.
    Swapping a face is now a one-line change here rather than 46 edits.
  */
  :root {
    --font-impact: 'Archivo Black', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --font-editorial: 'Newsreader', Georgia, 'Times New Roman', serif;
    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* Newsreader carries an optical size axis. Letting the browser drive it is
     what keeps a 13px eyebrow and a 30px heading both looking correct. */
  html {
    font-optical-sizing: auto;
  }

  /* Archivo Black has exactly one weight. Asking for a heavier one makes the
     browser synthesise a smeared fake bold, so pin it wherever impact is used. */
  h1,
  .statement,
  .fork-question,
  .funnel-cta-heading {
    font-weight: 400;
  }
</style>
</html>
