    .calc-plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; }

    .calc-plan input { position: absolute; opacity: 0; pointer-events: none; }

    .calc-plan span {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.1rem;
      padding: 0.7rem 0.4rem;
