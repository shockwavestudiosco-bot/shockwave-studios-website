    .calc-quip { font-family: var(--font-editorial); font-style: italic; font-size: 1.1rem; line-height: 1.45; color: rgba(255, 255, 255, 0.9); min-height: 3em; }

    .calc-result { margin-top: 0.75rem; padding-top: 1rem; border-top: 1px solid rgba(168, 197, 240, 0.3); }
    .calc-result p { margin: 0; font-size: 0.95rem; color: rgba(255, 255, 255, 0.8); }
    .calc-result .calc-money-out { font-family: var(--font-editorial); font-weight: 800; font-size: 2rem; color: #ffffff; margin: 0.15rem 0; }
    .calc-result .calc-money-out.is-down { color: #FFC9C9; }
