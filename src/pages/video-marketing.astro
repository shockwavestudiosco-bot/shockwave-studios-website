    .funnel-out {
      margin-top: 1.25rem;
      text-align: center;
      font-family: var(--font-editorial);
      font-style: italic;
      font-size: 1.15rem;
      color: var(--primary);
    }

    /* Build-down animation. ScrollReveal arms .reveal elements and adds
       .reveal-in on entry; the bands then drop in one after another. */
    .funnel.reveal-armed .fn { opacity: 0; transform: translateY(-10px) scaleX(0.92); }
    .funnel.reveal-armed.reveal-in .fn {
      opacity: 1;
      transform: none;
      transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--i) * 0.14s);
    }
    .funnel.reveal-armed { opacity: 1 !important; transform: none !important; }

    /* ---------- ad vs organic ---------- */

    .example-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      max-width: 900px;
      margin: 0 auto;
