---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FunnelCTA from '../components/FunnelCTA.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import InlineCTA from '../components/InlineCTA.astro';
import { CALENDLY_URL } from '../lib/site';

// Monthly plans. Restructured by Ashton 2026-09-23: everything is priced on
// volume of content. Prices are "starting at". Supersedes the 2026-09-21
// ladder (800/1400/2000, ads + organic counts, platforms, filming sessions,
// strategy calls), which is gone rather than carried over. Flat fee only; rev
// share was dropped on 2026-09-21 and stays out unless Ashton asks.
//
// Ads management is an add-on on every tier: +300 on Basic, +200 on
// Standard and Premium (Premium moved from 100 to 200 on 2026-09-23). Ad
// spend itself is billed to the client's own Meta Ads Manager (confirmed
// 2026-09-20). Profile revamp is on every card, per Ashton 2026-09-23.
//
// Every plan includes full strategy, scripts, and scheduling and posting.
// Standard and Premium add comment-to-DM automation and custom videos.
// On-site filming per month is 1+ / 2+ / 3+ (Ashton 2026-09-24: same counts
// as before, shown with a plus). Added to every plan the same day: monthly
// strategy call, hook and caption writing, posting to Reels/TikTok/Shorts,
// monthly performance report. [ASK Ashton: should any of those be tiered?]
//
// The cards lead with the video count and carry the price underneath. At
// position two on the page a bare price makes a cold visitor judge the number
// before they know what it buys; this order sells the volume first.
const plans = [
  { name: "Basic",    price: "$650",   videos: 8,  filming: "1+", dm: false, custom: null, adsAddon: "$300", featured: false },
  { name: "Standard", price: "$1,200", videos: 14, filming: "2+", dm: true,  custom: 1,    adsAddon: "$200", featured: true },
  { name: "Premium",  price: "$1,750", videos: 20, filming: "3+", dm: true,  custom: 2,    adsAddon: "$200", featured: false },
];

// The deliverables chart.
//
// `count` rows are where the tiers differ: a string shows as-is, `true` is a
// tick, `null` is "Not included". Everything else is yes across the board.
// Tier differences come first so a prospect sees the decision before the
// boilerplate.
const included = [
  { group: "What changes between plans" },
  { row: "Finished videos per month", basic: "8", standard: "14", premium: "20", count: true },
  { row: "On-site filming sessions per month", basic: "1+", standard: "2+", premium: "3+", count: true },
  { row: "Comment-to-DM automation", basic: null, standard: true, premium: true, count: true },
  { row: "Custom videos per month", basic: null, standard: "1", premium: "2", count: true },
  { row: "Ads management (optional add-on)", basic: "+$300/mo", standard: "+$200/mo", premium: "+$200/mo", count: true },

  { group: "In every plan" },
  { row: "Full content strategy", basic: true, standard: true, premium: true },
  { row: "Full profile revamp at onboarding", basic: true, standard: true, premium: true },
  { row: "Competitor audit of your niche", basic: true, standard: true, premium: true },
  { row: "Audit of your own account", basic: true, standard: true, premium: true },
  { row: "Content pillars built from both audits", basic: true, standard: true, premium: true },
  { row: "Scripts for every video", basic: true, standard: true, premium: true },
  { row: "Hook and caption written for every post", basic: true, standard: true, premium: true },
  { row: "Editing", basic: true, standard: true, premium: true },
  { row: "Scheduling and posting", basic: true, standard: true, premium: true },
  { row: "Posted to Reels, TikTok and Shorts", basic: true, standard: true, premium: true },
  { row: "Monthly strategy call", basic: true, standard: true, premium: true },
  { row: "Monthly performance report", basic: true, standard: true, premium: true },
  { row: "Raw files, yours to keep", basic: true, standard: true, premium: true },
];

// Questions, grouped into tabs so the section is one compact panel rather
// than a long list. Facts come from Ashton: month to month, one round of
// changes a month ("we make it work if there's a problem"), the final month's
// videos are theirs to keep (2026-09-24). [ASK Ashton: how soon does the
// first content go live after signing? Not answered yet, so not asked here.]
const faqGroups = [
  {
    name: "The Basics",
    items: [
      { q: "Is there a contract?", a: "No. It's month to month. You stay because it's working, not because you signed something." },
      { q: "Is my ad budget included?", a: "No. Your ad budget goes straight to your own Meta Ads Manager, so you set it, see every dollar, and keep the account. Ads management itself is an optional add-on to any plan." },
      { q: "Why run ads at all? Can't I just post more?", a: "Posting more only reaches people who already follow you or happen to get served your video. Ads put your offer in front of people who have never heard of you, today, in the amount you choose. Organic reach is earned over months. Paid reach is bought this afternoon." },
      { q: "Why content pillars instead of just good videos?", a: "A good video with no job is a lottery ticket. Pillars give every post a role, so the month covers proof, objections and personality instead of three versions of the same idea. It also means nobody is standing around on shoot day wondering what to film." },
    ],
  },
  {
    name: "Filming",
    items: [
      { q: "How often do you come out to film?", a: "Every plan includes on-site filming: 1+, 2+ or 3+ shoots a month depending on the plan. If the month needs another one, we make it happen." },
      { q: "Where do you film?", a: "On site, wherever your business actually happens. Your shop, your job site, your office." },
      { q: "Do I have to be on camera?", a: "You don't have to be good on camera. Directing you is part of the job." },
      { q: "What gear do you bring?", a: "Professional lighting, pro audio, 4K cameras and stabilized shots, every time." },
    ],
  },
  {
    name: "Scripts & Editing",
    items: [
      { q: "Who writes the scripts?", a: "We do. Every video gets a script built from your content pillars, plus the hook and caption that go with it." },
      { q: "Can I pitch my own ideas?", a: "Always. Standard and Premium also include custom videos every month where you pick the idea." },
      { q: "Do I see the videos before they go out?", a: "Yes. Each month includes a round of changes, and if something still isn't right after that, we sort it out." },
      { q: "What kind of videos are they?", a: "Short-form video built for Reels, TikTok and Shorts. Every one is tied to a content pillar, so it has a job to do." },
    ],
  },
  {
    name: "Posting & Results",
    items: [
      { q: "Do you post them for me?", a: "Yes. Scheduling and posting are in every plan, across Reels, TikTok and Shorts." },
      { q: "What is comment-to-DM automation?", a: "When someone comments a keyword on your post, they automatically get a DM with your offer or booking link. The lead gets caught while they're interested, even at 2am." },
      { q: "How do I know it's working?", a: "You get a performance report every month showing what worked, plus a strategy call to plan the next month around it." },
      { q: "Do I keep the videos if I cancel?", a: "Yes. The videos from your final month are yours to keep." },
    ],
  },
];

---
<Layout
  title="Video Marketing in Melbourne, FL | Shockwave Studios"
  description="How Shockwave Studios runs video marketing: paid ads that sell, organic content that makes you credible, and a content strategy built from real competitor data."
>
  <SiteHeader />

  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <p class="hero-eyebrow">Video Marketing</p>
        <h1>Ads That Sell. Content That Makes Them Believe You.</h1>
        <p class="subheadline">Most agencies will talk to you about a content calendar. That is the last thing that matters. Here is the actual strategy, in the order it matters.</p>
      </div>
    </section>

    <!-- ===== THE OFFER, UP FRONT =====
         Second on the page by design. Everything below this point exists to
         justify these three cards, so the visitor knows what is being sold
         before they are asked to care about how it works. -->
    <section class="sec sec-light" id="offer">
      <div class="sec-inner">
        <p class="sec-eyebrow reveal">The offer</p>
        <h2 class="reveal">Finished Videos, Every Month</h2>
        <p class="sec-lead reveal">Every plan gets the full strategy, a script for every video, and scheduling and posting handled. What changes is how many finished videos you get each month, plus automation and custom videos on the bigger plans.</p>

        <div class="plan-grid reveal">
          {plans.map(plan => (
            <div class={`plan-card ${plan.featured ? "plan-featured" : ""}`}>
              {plan.featured && <p class="plan-badge">Most Popular</p>}
              <p class="plan-name">{plan.name}</p>

              <p class="plan-headline">
                <span class="ph-pair"><strong>{plan.videos}</strong> <span>videos</span></span>
              </p>
              <p class="plan-sub">finished and posted, every month</p>

              <p class="plan-from">Starting at</p>
              <p class="plan-price">{plan.price}<span>/mo</span></p>

              <!-- The same rows on every card, so the tiers compare at a
                   glance without anyone having to scroll to the chart. -->
              <dl class="plan-spec">
                <div><dt>Strategy, scripts, posting</dt><dd><span class="spec-yes" aria-label="Included">&#10003;</span></dd></div>
                <div><dt>Profile revamp</dt><dd><span class="spec-yes" aria-label="Included">&#10003;</span></dd></div>
                <div><dt>On-site filming</dt><dd>{plan.filming}<span> / mo</span></dd></div>
                <div><dt>Comment-to-DM automation</dt><dd>{plan.dm ? <span class="spec-yes" aria-label="Included">&#10003;</span> : <em class="spec-none">Not included</em>}</dd></div>
                <div><dt>Custom videos</dt><dd>{plan.custom ? <>{plan.custom}<span> / mo</span></> : <em class="spec-none">Not included</em>}</dd></div>
                <div><dt>Ads management</dt><dd>+{plan.adsAddon}<span> / mo</span></dd></div>
              </dl>
            </div>
          ))}

          <!-- Custom: for volume or a mix the three plans do not cover. -->
          <div class="plan-card plan-custom">
            <div>
              <p class="plan-name">Custom</p>
              <p class="plan-headline plan-headline-custom">Built around you</p>
            </div>
            <p class="plan-sub">More than 20 videos, a different mix, or something specific in mind? Tell me what you need and I will put a plan together around it.</p>
            <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="plan-custom-btn" data-book="book_call_video_marketing_custom">Let's Talk</a>
          </div>
        </div>

        <!-- Confirmed by Ashton 2026-09-20: ad spend is billed separately,
             straight to the client's own Meta Ads Manager. Management fee
             per tier set 2026-09-23. -->
        <div class="plan-note reveal">
          <p class="plan-note-title">Ads management is an add-on</p>
          <p>Want me running paid ads with your videos? That is +$300/mo on Basic and +$200/mo on Standard or Premium. Your ad budget itself is billed straight to your own Meta Ads Manager, so you set it, you can see every dollar of it, and the ad account stays yours.</p>
        </div>

        <p class="plan-alt reveal">Need a single video instead of a monthly plan? That is <a href="/video-production">video production</a>.</p>
      </div>
    </section>

    <InlineCTA
      path="video_marketing"
      text="Seen enough? The rest of this page is how it works."
    />


    <!-- ===== AD VS ORGANIC ===== -->
    <section class="sec sec-white" id="examples">
      <div class="sec-inner">
        <h2 class="h2-minor reveal">An Ad and an Organic Post, Side by Side</h2>
        <p class="sec-lead reveal">Two videos doing two completely different jobs. One is built to sell. The other is built to make the first one believable.</p>

        <!--
          Both sourced from Ashton 2026-09-21 and re-encoded from 2160x3840 4K
          masters down to 1080x1920 (CRF 26, faststart) for the 25MB Cloudflare
          per-file limit. preload="none" so neither downloads until played.
        -->
        <div class="example-grid reveal">
          <figure class="example-item">
            <video class="example-video" controls preload="none" playsinline poster="/videos/ad-example.webp">
              <source src="/videos/ad-example.mp4" type="video/mp4" />
            </video>
            <figcaption>
              <h3>The Ad</h3>
            </figcaption>
          </figure>

          <figure class="example-item">
            <video class="example-video" controls preload="none" playsinline poster="/videos/organic-example.webp">
              <source src="/videos/organic-example.mp4" type="video/mp4" />
            </video>
            <figcaption>
              <h3>The Organic Post</h3>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ===== THE PROSPECT JOURNEY =====
         Two closes with the same shape (five steps and an outcome). The ad
         close has a shortcut branch for the people who see one ad, check the
         profile and buy on the spot. Rewritten 2026-09-24. -->
    <section class="sec sec-light" id="journey">
      <div class="sec-inner">
        <p class="sec-eyebrow reveal">The prospect journey</p>
        <h2 class="reveal">Two Ways Someone Becomes a Client</h2>
        <p class="sec-lead reveal">Every step is coloured by what's doing the work. Most clients come in through one of these two.</p>

        <div class="legend reveal">
          <span class="legend-item"><span class="dot dot-paid"></span>Paid ad doing the work</span>
          <span class="legend-item"><span class="dot dot-organic"></span>Organic doing the work</span>
          <span class="legend-item"><span class="dot dot-both"></span>Both at once</span>
        </div>

        <div class="routes">

          <article class="route reveal">
            <header class="route-head">
              <p class="route-tag">Route 1</p>
              <h3>The Organic Close</h3>
              <p class="route-note">Slower. Ends in your most loyal clients.</p>
            </header>

            <ol class="route-steps">
              <li class="rs rs-organic">
                <span class="rs-dot"></span>
                <span class="rs-tag">Organic</span>
                <p>They come across your content and follow or engage with it.</p>
              </li>
              <li class="rs rs-organic">
                <span class="rs-dot"></span>
                <span class="rs-tag">Organic</span>
                <p>They keep seeing you. Trust builds over weeks, not minutes.</p>
              </li>
              <li class="rs rs-none">
                <span class="rs-dot"></span>
                <span class="rs-tag">Neither</span>
                <p>The day they need what you sell, they go looking for more.</p>
              </li>
              <li class="rs rs-organic">
                <span class="rs-dot"></span>
                <span class="rs-tag">Organic</span>
                <p>Your page answers their questions before they have to ask.</p>
              </li>
              <li class="rs rs-organic">
                <span class="rs-dot"></span>
                <span class="rs-tag">Organic</span>
                <p>They reach out already sold on you.</p>
              </li>
            </ol>

            <p class="route-out">They come in as a warm lead</p>
          </article>

          <article class="route reveal">
            <header class="route-head">
              <p class="route-tag">Route 2</p>
              <h3>The Ad Close</h3>
              <p class="route-note">Faster. For people who need it now.</p>
            </header>

            <ol class="route-steps">
              <li class="rs rs-paid">
                <span class="rs-dot"></span>
                <span class="rs-tag">Paid</span>
                <p>An ad puts your offer in front of someone who has never heard of you.</p>
                <div class="rs-branch">
                  <p class="rs-branch-tag">Shortcut</p>
                  <p>Some see one ad, check your profile, and buy on the spot.</p>
                </div>
              </li>
              <li class="rs rs-none">
                <span class="rs-dot"></span>
                <span class="rs-tag">Neither</span>
                <p>Most don't buy the first time. Almost nobody does.</p>
              </li>
              <li class="rs rs-organic">
                <span class="rs-dot"></span>
                <span class="rs-tag">Organic</span>
                <p>They check your profile. It's active and real, so you pass.</p>
              </li>
              <li class="rs rs-paid">
                <span class="rs-dot"></span>
                <span class="rs-tag">Paid</span>
                <p>Retargeting brings the offer back while they're still thinking.</p>
              </li>
              <li class="rs rs-both">
                <span class="rs-dot"></span>
                <span class="rs-tag">Both</span>
                <p>Your ads and your content land together, and they're ready.</p>
              </li>
            </ol>

            <p class="route-out">They book a call</p>
          </article>

        </div>
      </div>
    </section>

    <!-- ===== CREATIVE STRATEGY =====
         A four-band funnel, research at the wide end, pillars at the narrow
         end. Bands build down one after another as it scrolls in. Replaces the
         two-panel audits layout and the ad/organic slot grid (2026-09-24). -->
    <section class="sec sec-mist" id="strategy">
      <div class="sec-inner">
        <p class="sec-eyebrow reveal">The creative strategy</p>
        <h2 class="h2-minor reveal">From Research to Content Pillars</h2>

        <ol class="funnel reveal">
          <li class="fn" style="--i: 0">
            <span class="fn-num">01</span>
            <div class="fn-body">
              <h3>Research</h3>
              <p>Your competitors, your niche and your own profile.</p>
            </div>
          </li>
          <li class="fn" style="--i: 1">
            <span class="fn-num">02</span>
            <div class="fn-body">
              <h3>Profile Rebuild</h3>
              <p>Your page answers every question a lead has in the first 5 seconds.</p>
            </div>
          </li>
          <li class="fn" style="--i: 2">
            <span class="fn-num">03</span>
            <div class="fn-body">
              <h3>Strategy</h3>
              <p>Who we're talking to, what they need to hear, and where.</p>
            </div>
          </li>
          <li class="fn" style="--i: 3">
            <span class="fn-num">04</span>
            <div class="fn-body">
              <h3>Content Pillars</h3>
              <p>Repeatable video types, each with a job.</p>
            </div>
          </li>
        </ol>
        <p class="funnel-out reveal">Every video has a job before a camera comes out.</p>
      </div>
    </section>

    <!-- ===== WHAT YOU GET =====
         Was "The Easy Part, Already Handled" as four cards. Now the chart. -->
    <section class="sec sec-white" id="included">
      <div class="sec-inner">
        <p class="sec-eyebrow reveal">Every month</p>
        <h2 class="reveal">Exactly What You Get</h2>
        <p class="sec-lead reveal">On-site filming, scripts, editing, posting and a monthly report are in every plan. The table shows what grows as you move up.</p>

        <div class="chart-wrap reveal">
          <table class="chart">
            <caption class="visually-hidden">What is included in each monthly plan</caption>
            <thead>
              <tr>
                <th scope="col" class="chart-rowhead">Included</th>
                {plans.map(p => (
                  <th scope="col" class={p.featured ? "chart-featured" : ""}>
                    <span class="chart-tier">{p.name}</span>
                    <span class="chart-price"><small>from</small> {p.price}</span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {included.map(item => (
                item.group ? (
                  <tr class="chart-grouprow">
                    <th scope="colgroup" colspan="4">{item.group}</th>
                  </tr>
                ) : (
                  <tr class={item.count ? "chart-countrow" : ""}>
                    <th scope="row" class="chart-rowhead">{item.row}</th>
                    <td>
                      {item.count
                        ? (item.basic === true ? <span class="chart-yes" aria-label="Included">&#10003;</span> : item.basic ? <span class="chart-num">{item.basic}</span> : <span class="chart-no">Not included</span>)
                        : <span class="chart-yes" aria-label="Included">&#10003;</span>}
                    </td>
                    <td class="chart-featured">
                      {item.count
                        ? (item.standard === true ? <span class="chart-yes" aria-label="Included">&#10003;</span> : item.standard ? <span class="chart-num">{item.standard}</span> : <span class="chart-no">Not included</span>)
                        : <span class="chart-yes" aria-label="Included">&#10003;</span>}
                    </td>
                    <td>
                      {item.count
                        ? (item.premium === true ? <span class="chart-yes" aria-label="Included">&#10003;</span> : item.premium ? <span class="chart-num">{item.premium}</span> : <span class="chart-no">Not included</span>)
                        : <span class="chart-yes" aria-label="Included">&#10003;</span>}
                    </td>
                  </tr>
                )
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===== ROI CALCULATOR =====
         The visitor's own numbers, no invented results. Defaults are an
         example only and say so. Rewritten from the static "I am not going to
         throw a number at you" steps on 2026-09-24. -->
    <section class="sec sec-mist" id="roi">
      <div class="sec-inner">
        <p class="sec-eyebrow reveal">The math</p>
        <h2 class="h2-minor reveal">Will It Pay for Itself?</h2>
        <p class="calc-sub reveal">Plug in your numbers. Nothing here is a promise, it's just math.</p>

        <div class="calc reveal" data-calc>
          <div class="calc-in">
            <label class="calc-field">
              <span class="calc-label">What's one new customer worth to you?</span>
              <span class="calc-hint">Everything they'd spend with you, not just the first job.</span>
              <span class="calc-money"><span aria-hidden="true">$</span><input type="number" inputmode="numeric" min="0" step="50" value="500" data-calc-value aria-label="Value of one new customer in dollars" /></span>
            </label>

            <fieldset class="calc-field">
              <legend class="calc-label">Pick a plan</legend>
              <div class="calc-plans">
                {plans.map(p => (
                  <label class="calc-plan">
                    <input type="radio" name="calc-plan" value={p.price.replace(/[$,]/g, "")} data-ads={p.adsAddon.replace(/[$,]/g, "")} checked={p.featured} />
                    <span>{p.name}<small>{p.price}/mo</small></span>
                  </label>
                ))}
              </div>
              <label class="calc-check"><input type="checkbox" data-calc-ads /> Add ads management</label>
            </fieldset>

            <label class="calc-field">
              <span class="calc-label">New customers a month from your videos: <strong data-calc-n-label>3</strong></span>
              <input type="range" min="0" max="20" step="1" value="3" data-calc-n aria-label="New customers per month" />
            </label>
          </div>

          <div class="calc-out" aria-live="polite">
            <p class="calc-kicker">You break even at</p>
            <p class="calc-big"><span data-calc-break>3</span><small data-calc-break-unit>customers a month</small></p>
            <p class="calc-quip" data-calc-quip></p>
            <div class="calc-result">
              <p data-calc-result-label>At 3 new customers a month you'd be up</p>
              <p class="calc-money-out" data-calc-up>$300</p>
              <p class="calc-multiple" data-calc-multiple></p>
            </div>
          </div>
        </div>

        <p class="calc-note reveal">Doesn't include your ad budget, which goes straight to your own Meta account. Plan prices are starting prices.</p>
      </div>
    </section>

    <!-- ===== QUESTIONS =====
         Tabs by topic, each an accordion, so the section stays one panel
         tall. Without JavaScript every group shows, stacked. -->
    <section class="sec sec-white" id="questions">
      <div class="sec-inner sec-inner-narrow">
        <h2 class="h2-minor reveal">Questions You're Probably Asking</h2>

        <div class="faq reveal" data-faq>
          <div class="faq-tabs" role="tablist" aria-label="Question topics">
            {faqGroups.map((g, i) => (
              <button type="button" role="tab" class="faq-tab" id={`faq-tab-${i}`} aria-controls={`faq-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{g.name}</button>
            ))}
          </div>
          {faqGroups.map((g, i) => (
            <div class="faq-panel" role="tabpanel" id={`faq-panel-${i}`} aria-labelledby={`faq-tab-${i}`} data-faq-panel>
              <p class="faq-group-name">{g.name}</p>
              {g.items.map((item, j) => (
                <details class="faq-item" open={i === 0 && j === 0}>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <FunnelCTA
      path="video_marketing"
      calendlyParam="Video Marketing"
      heading="Let's Build Your Engine"
      body="Book a call. Before we talk I go through your account and the accounts of the people you compete with, so I show up with something specific instead of a pitch deck."
      bullets={[
        "What your competitors are already winning with",
        "The pillars I would build your month around",
        "The first ad angle I would put money behind",
      ]}
      buttonLabel="Book Your Call"
      note="Free, no commitment. Add your business name when you book so I can look you up first."
    />
