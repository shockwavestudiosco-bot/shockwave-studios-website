    .chart-grouprow th {
      padding-top: 1.9rem;
      padding-bottom: 0.6rem;
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--label);
      text-align: left;
      background: transparent;
    }

    .chart-grouprow { border-bottom: 2px solid var(--rule) !important; }
    .chart tbody tr.chart-grouprow:first-child th { padding-top: 0.6rem; }

    /* a quiet vertical band marking the featured tier down the whole chart */
    .chart-featured { background: rgba(27, 58, 107, 0.05); }
    .chart-countrow .chart-featured { background: rgba(27, 58, 107, 0.1); }

    /* ---------- roi calculator ---------- */

    .calc-sub {
      font-family: var(--font-editorial);
      font-style: italic;
      font-size: 1.15rem;
