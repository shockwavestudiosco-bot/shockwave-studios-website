    .calc-kicker { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }

    .calc-big { display: flex; align-items: baseline; gap: 0.6rem; font-family: var(--font-editorial); font-weight: 800; line-height: 1; }
    .calc-big span { font-size: clamp(3rem, 7vw, 4.25rem); }
