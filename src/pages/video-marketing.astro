    .calc-check { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.4rem; font-size: 0.95rem; font-weight: 600; color: rgba(26, 26, 46, 0.75); cursor: pointer; }
    .calc-check input { width: 18px; height: 18px; accent-color: var(--primary); }

    .calc-field input[type="range"] { width: 100%; accent-color: var(--primary); height: 28px; }

    .calc-out {
      padding: 2rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
