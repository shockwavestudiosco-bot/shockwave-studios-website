    .calc-note { margin-top: 1rem; font-size: 0.88rem; color: rgba(26, 26, 46, 0.6); text-align: center; }

    /* ---------- questions: tabs + accordion ---------- */

    .faq-tabs { display: none; }
    .faq.is-tabbed .faq-tabs {
