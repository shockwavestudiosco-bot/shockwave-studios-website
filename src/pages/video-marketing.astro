    .calc-in { padding: 2rem; display: flex; flex-direction: column; gap: 1.6rem; }

    .calc-field { display: flex; flex-direction: column; gap: 0.45rem; border: 0; padding: 0; margin: 0; min-width: 0; }

    .calc-label { font-weight: 700; font-size: 1rem; color: var(--primary); padding: 0; }
