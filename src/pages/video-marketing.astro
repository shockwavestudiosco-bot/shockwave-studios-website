  <script>
    // ----- ROI calculator. All inputs are the visitor's; nothing is claimed.
    const calc = document.querySelector<HTMLElement>('[data-calc]');
    if (calc) {
      const money = (n: number) => '$' + Math.round(Math.abs(n)).toLocaleString('en-US');
      const $ = <T extends Element>(sel: string) => calc.querySelector<T>(sel)!;
      const valueIn = $<HTMLInputElement>('[data-calc-value]');
      const adsIn = $<HTMLInputElement>('[data-calc-ads]');
      const nIn = $<HTMLInputElement>('[data-calc-n]');

      const render = () => {
        const plan = calc.querySelector<HTMLInputElement>('input[name="calc-plan"]:checked');
        const fee = (plan ? +plan.value : 0) + (adsIn.checked && plan ? +(plan.dataset.ads || 0) : 0);
        const value = Math.max(0, +valueIn.value || 0);
        const n = +nIn.value;
        $('[data-calc-n-label]').textContent = String(n);

        const breakEven = value > 0 ? Math.ceil(fee / value) : Infinity;
        $('[data-calc-break]').textContent = Number.isFinite(breakEven) ? String(breakEven) : '?';
        $('[data-calc-break-unit]').textContent = breakEven === 1 ? 'customer a month' : 'customers a month';

        let quip = 'Pop in what a customer is worth and I\'ll do the math.';
        if (Number.isFinite(breakEven)) {
          if (breakEven <= 1) quip = 'One customer covers it. Everything after that is gravy.';
          else if (breakEven <= 2) quip = 'Two customers. Roughly one every couple of weeks.';
          else if (breakEven <= 4) quip = `${breakEven} a month. About one every ${Math.round(30 / breakEven)} days.`;
          else quip = `That's ${breakEven} a month. Tell me on the call and I'll be straight with you about whether now's the time.`;
        }
        $('[data-calc-quip]').textContent = quip;

        if (value <= 0) {
          $('[data-calc-result-label]').textContent = 'Your monthly result';
          $('[data-calc-up]').textContent = '$0/mo';
          $('[data-calc-multiple]').textContent = 'Add what a customer is worth above to see this.';
          return;
        }
        const up = n * value - fee;
        $('[data-calc-result-label]').textContent =
          `At ${n} new customer${n === 1 ? '' : 's'} a month you'd be ${up >= 0 ? 'up' : 'down'}`;
        const out = $('[data-calc-up]');
        out.textContent = money(up) + '/mo';
        out.classList.toggle('is-down', up < 0);
        const multiple = fee > 0 ? (n * value) / fee : 0;
        $('[data-calc-multiple]').textContent = up > 0
          ? multiple >= 1.5
            ? `That's $${multiple.toFixed(2)} back for every $1 you spend. Your accountant would like a word, a nice one.`
            : `That's $${multiple.toFixed(2)} back for every $1. In the green, and every extra customer widens it.`
          : up === 0 ? 'Right at break even. Every customer after this one is profit.'
          : 'Below break even at that pace. Worth a conversation before you spend a dime.';
      };

      calc.addEventListener('input', render);
      calc.addEventListener('change', render);
      render();
    }

    // ----- Question tabs. Arrow keys move between tabs, per the tabs pattern.
    const faq = document.querySelector<HTMLElement>('[data-faq]');
    if (faq) {
      const tabs = [...faq.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...faq.querySelectorAll<HTMLElement>('[data-faq-panel]')];
      faq.classList.add('is-tabbed');
      const select = (i: number, focus = false) => {
        tabs.forEach((t, k) => {
          const on = k === i;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          panels[k].hidden = !on;
        });
        if (focus) tabs[i].focus();
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % tabs.length, true); }
          if (e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
        });
      });
      select(0);
    }
  </script>

