---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FunnelCTA from '../components/FunnelCTA.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import InlineCTA from '../components/InlineCTA.astro';

// The six steps. Kept to a word or two each on purpose (Ashton 2026-09-23):
// the process is simple and the page should not over-explain it. Facts
// (half day, two rounds, under five days) match the specs list below.
// Icons are Lucide-style strokes, 24px grid.
const steps = [
  { title: "Discovery Call", note: "What the video is for", icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>' },
  { title: "Plan Call", note: "See the plan and price", icon: '<rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>' },
  { title: "Book the Date", note: "Date locked in", icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>' },
  { title: "Shoot", note: "Half a day on site", icon: '<path d="m16 13 5.2 3.5a.5.5 0 0 0 .8-.4V7.9a.5.5 0 0 0-.8-.4L16 11"/><rect x="2" y="6" width="14" height="12" rx="2"/>' },
  { title: "Edit", note: "Two rounds of changes", icon: '<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/>' },
  { title: "Deliver", note: "Usually within 5 days", icon: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>' },
];

const specs = [
  { value: "Half day", label: "Shoot length", note: "Up to four hours on site as standard. Anything longer gets scoped and priced in the proposal." },
  { value: "2 rounds", label: "Revisions included", note: "Two rounds of changes after the first cut. Send notes as timestamps and they get handled." },
  { value: "Under 5 days", label: "Typical turnaround", note: "Most projects are delivered within five business days of the shoot. Bigger builds take longer, and you will know that upfront." },
  { value: "Google Drive", label: "How you get it", note: "Final files delivered through Drive. Download them and they are yours to keep and reuse." },
];

// Six examples, all already compressed and in the repo so nothing is
// re-encoded. All six are 1080x1920, which matters: the display box is 9/16
// with object-fit cover, so a landscape clip would be cropped to a sliver.
// driftline-roofing, g37, fca-* and marlo are 1920x1080 and deliberately not
// used here for that reason. The first three carry the same labels the
// /videography package cards use, so those labels are not invented.
const examples = [
  { src: "/videos/real-estate-example.mp4", label: "Real Estate Listing" },
  { src: "/videos/event-example.mp4", label: "Event Coverage" },
  { src: "/videos/brandexample.mp4", label: "Brand and Promo" },
  { src: "/videos/portfolio/93-f250.mp4", poster: "/videos/portfolio/93-f250.jpg", label: "Vehicle Feature" },
  { src: "/videos/portfolio/markle.mp4", poster: "/videos/portfolio/markle.jpg", label: "Construction Showcase" },
  { src: "/videos/portfolio/pwo.mp4", poster: "/videos/portfolio/pwo.jpg", label: "Gym Promo" },
];
---
<Layout
  title="Video Production in Melbourne, FL | Shockwave Studios"
  description="High-quality video production in Melbourne, FL. Two quick calls to plan it, half a day to shoot it, and final files usually within five business days."
>
  <SiteHeader />

  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <p class="hero-eyebrow">Video Production</p>
        <h1>High-Quality Video Production.</h1>
        <p class="subheadline">Made by people who care how it turns out. One video, no monthly commitment.</p>
      </div>
    </section>

    <!-- ===== THE PROCESS =====
         One short line and six icon steps. Replaces the long "a shoot that
         goes wrong..." statement and the six-card timeline, which took
         several screens to scroll on a phone. -->
    <section class="sec sec-white steps" id="process">
      <div class="sec-inner">
        <p class="sec-eyebrow reveal">How it works</p>
        <h2 class="h2-minor reveal">Plan It, Shoot It, Deliver It</h2>
        <p class="steps-lead reveal">Two quick calls up front so we both know what the video is for. After that, it's just getting it done.</p>

        <ol class="step-grid reveal">
          {steps.map((step, i) => (
            <li class="step">
              <span class="step-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon} />
              </span>
              <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.note}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===== WHAT YOU GET =====
         Mid-tone band. Runs as a list rather than four boxes, so it does not
         repeat the card grid the examples section uses below it. -->
    <section class="sec sec-mist" id="specs">
      <div class="sec-inner">
        <h2 class="h2-minor reveal">What You Get</h2>

        <dl class="spec-list">
          {specs.map(s => (
            <div class="spec-row reveal">
              <dt>{s.value}</dt>
              <dd>
                <span class="spec-label">{s.label}</span>
                <span class="spec-note">{s.note}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <InlineCTA
      path="video_production"
      text="That is the whole process. Ready to talk about yours?"
    />

    <!-- ===== EXAMPLES ===== -->
    <section class="sec sec-white" id="examples">
      <div class="sec-inner">
        <h2 class="h2-minor reveal">Recent Projects</h2>
        <p class="sec-lead reveal">Three different jobs, three different builds. Same process behind all of them.</p>

        <div class="example-grid reveal">
          {examples.map(ex => (
            <figure class="example-item">
              <video class="example-video" controls preload="none" playsinline poster={ex.poster}>
                <source src={ex.src} type="video/mp4" />
              </video>
              <figcaption>{ex.label}</figcaption>
            </figure>
          ))}
        </div>

        <p class="example-note reveal">Want packages and prices instead? They are on the <a href="/videography">packages page</a>.</p>
      </div>
    </section>

    <FunnelCTA
      path="video_production"
      calendlyParam="Video Production"
      heading="Let's Plan Your Shoot"
      body="Book the discovery call. We work out what the video has to do and where it needs to live, then I build the plan and walk you through it live on call two."
      bullets={[
        "What the video actually needs to accomplish",
        "Where it is going to live and how that changes the build",
        "What it takes to shoot it, and what it costs",
      ]}
      buttonLabel="Book Your Call"
      note="Free, no commitment. Tell me what you have in mind when you book."
    />
  </main>

  <SiteFooter />

  <ScrollReveal />

  <style>
    /* Navy is punctuation on this page, not alternation. It appears twice:
       the hero and the closing CTA. Everything between lives in a narrow
       light band (--bg 0.91 luminance, white 1.0, --mist 0.84) so scrolling
       never swings the whole viewport from near-black to near-white. */
    :root {
      --bg: #F4F7FC;
      --bg-secondary: #FFFFFF;
      --mist: #E7EEF9;
      --accent: #A8C5F0;
      --primary: #1B3A6B;
      --primary-deep: #0F2145;
      --secondary: #5B8FD4;
      --label: #3A67AC;
      --text: #1A1A2E;
      --rule: rgba(27, 58, 107, 0.14);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-weight: 600;
    }

    a { color: inherit; text-decoration: none; }

    h1 {
      font-family: var(--font-impact);
      font-weight: 400;
      letter-spacing: -0.015em;
      color: var(--primary);
    }

    h2, h3 {
      font-family: var(--font-editorial);
      font-weight: 700;
      letter-spacing: -0.005em;
      color: var(--primary);
    }

    /* ---------- header / nav (shared pattern) ---------- */

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5%;
      height: 88px;
      background: var(--bg);
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid rgba(168, 197, 240, 0.1);
    }

    .logo-link { display: flex; align-items: center; height: 100%; overflow: hidden; }
    .logo-img { height: 192px; width: auto; display: block; }
    .footer-logo-img { height: 160px; width: auto; display: block; }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
      align-items: center;
    }

    .nav-links a {
      font-weight: 500;
      font-size: 0.95rem;
      transition: color 0.2s ease;
    }

    .nav-links a:hover { color: var(--label); }

    .has-dropdown { position: relative; }

    .dropdown {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background: var(--bg-secondary);
      border: 1px solid rgba(168, 197, 240, 0.15);
      border-radius: 10px;
      min-width: 220px;
      box-shadow: 0 8px 24px rgba(27, 58, 107, 0.12);
      padding: 0.5rem 0;
      list-style: none;
      flex-direction: column;
      z-index: 200;
    }

    .has-dropdown:hover .dropdown { display: flex; }

    .dropdown li a {
      display: block;
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
      color: var(--text);
    }

    .dropdown li a:hover {
      background: rgba(168, 197, 240, 0.12);
      color: var(--primary);
    }

    .nav-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
    }

    .nav-toggle span { display: block; width: 24px; height: 2px; background: var(--text); }

    /* ---------- hero (dark moment 1 of 2) ---------- */

    /* Photographic hero, same treatment as the homepage. The gradient is a
       little heavier here because these heroes carry more type than the
       homepage one does. --primary-deep stays as the colour underneath so a
       missing or slow image never leaves white text on white, and the gradient
       is dark enough that white type clears 7.8:1 over even a pure white photo.

       The source (1884, the beach shoot) is a 3024x4032 iPhone portrait, pre-cropped to 3:2
       around its subject and shipped at 1920x1280 / ~180KB. Cropping here
       rather than letting CSS guess is why background-position is just
       'center'. Do not add a second background-image layer as a fallback:
       browsers fetch every layer, so an unused one is a silent download.

       TO SWAP: replace public/hero-video-production.jpg, same aspect, keep it under ~400KB. */
    .page-hero {
      position: relative;
      background-color: var(--primary-deep);
      background-image: url('/hero-video-production.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .page-hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(10, 20, 45, 0.74) 0%, rgba(10, 20, 45, 0.88) 100%);
      z-index: 0;
    }

    .page-hero-inner {
      position: relative;
      z-index: 1;
      max-width: 940px;
      margin: 0 auto;
      padding: 7rem 5% 6rem;
      text-align: center;
    }

    .hero-eyebrow {
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.5rem;
    }

    .page-hero h1 {
      font-size: clamp(2.4rem, 6vw, 4.4rem);
      line-height: 1.08;
      letter-spacing: -0.02em;
      margin-bottom: 1.75rem;
      color: #ffffff;
    }

    .subheadline {
      font-family: var(--font-editorial);
      font-style: italic;
      font-weight: 400;
      font-size: clamp(1.15rem, 2.2vw, 1.5rem);
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.72);
      max-width: 720px;
      margin: 0 auto;
    }

    /* ---------- section shell ---------- */

    .sec { padding: 7rem 5%; }
    .sec-light { background: var(--bg); }
    .sec-white { background: var(--bg-secondary); }
    .sec-mist { background: var(--mist); }

    .sec-inner { max-width: 1150px; margin: 0 auto; }
    .sec-inner-narrow { max-width: 860px; }

    .sec-eyebrow {
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--label);
      margin-bottom: 1.25rem;
    }

    /* Two heading scales, not one. Major for act breaks, minor for the
       sub-beats, so the page has a hierarchy instead of ten equal shouts. */
    .sec h2 {
      font-size: clamp(2rem, 4.6vw, 3.2rem);
      line-height: 1.12;
      letter-spacing: -0.01em;
      margin-bottom: 1.5rem;
    }

    .sec h2.h2-minor {
      font-size: clamp(1.5rem, 3vw, 2.1rem);
      margin-bottom: 2.5rem;
    }

    .sec-lead {
      font-size: clamp(1.1rem, 2vw, 1.35rem);
      line-height: 1.6;
      color: rgba(26, 26, 46, 0.7);
      max-width: 760px;
      margin: -1.5rem 0 3.5rem;
    }

    /* ---------- the process: six icon steps ---------- */

    .steps { text-align: center; }
    .steps .sec-eyebrow { margin-bottom: 0.75rem; }
    .steps h2.h2-minor { margin-bottom: 0.9rem; }

    .steps-lead {
      max-width: 560px;
      margin: 0 auto 3rem;
      font-size: 1.05rem;
      line-height: 1.6;
      color: rgba(26, 26, 46, 0.7);
    }

    .step-grid {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1rem;
      position: relative;
    }

    /* a thin line joining the six icons */
    .step-grid::before {
      content: "";
      position: absolute;
      top: 28px;
      left: 8%;
      right: 8%;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent) 12%, var(--accent) 88%, transparent);
      z-index: 0;
    }

    .step {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }

    .step-icon {
      display: grid;
      place-items: center;
      width: 58px;
      height: 58px;
      margin-bottom: 0.4rem;
      border-radius: 50%;
      color: var(--primary);
      background: var(--bg);
      border: 2px solid var(--accent);
      box-shadow: 0 0 0 6px var(--bg-secondary);
    }

    .step-num {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      color: var(--label);
    }

    .step h3 {
      font-size: 1.1rem;
      line-height: 1.2;
      color: var(--primary);
    }

    .step p {
      font-size: 0.9rem;
      line-height: 1.4;
      color: rgba(26, 26, 46, 0.62);
    }

    /* ---------- specs, as a list not a card grid ---------- */

    .spec-list { border-top: 1px solid var(--rule); }

    .spec-row {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 2.5rem;
      align-items: baseline;
      padding: 2rem 0;
      border-bottom: 1px solid var(--rule);
    }

    .spec-row dt {
      font-family: var(--font-editorial);
      font-weight: 800;
      font-size: clamp(1.3rem, 2.6vw, 1.75rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--primary);
    }

    .spec-row dd { margin: 0; }

    .spec-label {
      display: block;
      font-weight: 700;
      font-size: 0.78rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--label);
      margin-bottom: 0.5rem;
    }

    .spec-note {
      display: block;
      font-size: 1.05rem;
      line-height: 1.65;
      color: rgba(26, 26, 46, 0.72);
      max-width: 640px;
    }

    /* ---------- examples ---------- */

    .example-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .example-item { display: flex; flex-direction: column; gap: 1rem; }

    .example-video {
      width: 100%;
      aspect-ratio: 9 / 16;
      border-radius: 14px;
      background: #000;
      display: block;
      object-fit: cover;
    }

    .example-item figcaption {
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--primary);
    }

    .example-note {
      margin-top: 3rem;
      text-align: center;
      font-family: var(--font-editorial);
      font-style: italic;
      font-weight: 400;
      font-size: clamp(1rem, 2vw, 1.2rem);
      color: rgba(26, 26, 46, 0.68);
    }

    .example-note a {
      color: var(--label);
      font-weight: 700;
      font-family: var(--font-body);
      font-style: normal;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    /* ---------- footer ---------- */

    .site-footer {
      padding: 1.5rem 5% 1.25rem;
      border-top: 1px solid rgba(168, 197, 240, 0.1);
      text-align: center;
      background: var(--bg);
    }

    .footer-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
    }

    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem 2rem;
    }

    .copyright {
      color: rgba(26, 26, 46, 0.4);
      font-size: 0.85rem;
    }

    /* ---------- responsive ---------- */

    @media (max-width: 1000px) {
      .step-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 2rem; }
      .step-grid::before { display: none; }
      .example-grid { grid-template-columns: repeat(2, 1fr); }
      .spec-row { grid-template-columns: 200px 1fr; gap: 1.75rem; }
    }

    @media (max-width: 768px) {
      .logo-img { height: 144px; }
      .nav-toggle { display: flex; }

      .nav-links {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--bg-secondary);
        flex-direction: column;
        gap: 0;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
      }

      .nav-links.open { max-height: 500px; }

      .nav-links li {
        width: 100%;
        border-top: 1px solid rgba(168, 197, 240, 0.1);
      }

      .nav-links a { display: block; padding: 1rem 5%; }

      .has-dropdown .dropdown {
        display: flex;
        position: static;
        box-shadow: none;
        border: none;
        border-radius: 0;
        background: rgba(168, 197, 240, 0.06);
        padding: 0;
        min-width: unset;
      }

      .dropdown li a { padding-left: 10%; }

      .sec { padding: 4.5rem 5%; }
      .page-hero-inner { padding: 4.5rem 5% 4rem; }
      .sec-lead { margin: -0.75rem 0 2.5rem; }

      /* phones: two rows of three, no joining line */
      .step-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.75rem 0.5rem; }
      .step-grid::before { display: none; }
      .step-icon { width: 50px; height: 50px; }
      .step h3 { font-size: 0.98rem; }
      .step p { font-size: 0.8rem; }
      .steps-lead { margin-bottom: 2.25rem; font-size: 1rem; }

      .spec-row { grid-template-columns: 1fr; gap: 0.75rem; padding: 1.5rem 0; }

      .example-grid { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
      .nav-links { transition: none; }
      .nav-links a { transition: none; }
    }
  </style>
</Layout>
