---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BottomCTA from '../components/BottomCTA.astro';
import FullscreenVideo from '../components/FullscreenVideo.astro';
// Portfolio collection, self-hosted from public/videos/portfolio/.
// Each entry needs a matching <slug>.mp4 and <slug>.jpg poster frame.
// To add one: compress to 1080p under 20MB, drop both files in, add a line.
const portfolioVideos = [
  { slug: "driftline-roofing",      orientation: "landscape" },
  { slug: "fca-beach",              orientation: "landscape" },
  { slug: "missy-promo",            orientation: "portrait" },
  { slug: "immersive-beach",        orientation: "portrait" },
  { slug: "satisfying",             orientation: "portrait" },
  { slug: "concrete-day",           orientation: "portrait" },
  { slug: "markle",                 orientation: "portrait" },
  { slug: "shockwave-talking-head", orientation: "portrait" },
  { slug: "kendall",                orientation: "portrait" },
  { slug: "g37",                    orientation: "landscape" },
  { slug: "93-f250",                orientation: "portrait" },
  { slug: "marlo",                  orientation: "landscape" },
  { slug: "hurricane-pools",        orientation: "portrait" },
  { slug: "first-boss",             orientation: "portrait" },
  { slug: "dominicks",              orientation: "portrait" },
  { slug: "fca-done",               orientation: "landscape" },
  { slug: "anniversary",            orientation: "portrait" },
  { slug: "real-estate",            orientation: "portrait" },
  { slug: "pwo",                    orientation: "portrait" },
  { slug: "shockwave-brand",        orientation: "portrait" },
];
---
<Layout
  title="Portfolio | Shockwave Studios"
  description="See real social media content Shockwave Studios has produced for businesses in Melbourne, Florida."
>
  <SiteHeader />

  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <h1>Content That Actually Performs.</h1>
        <p class="subheadline">Real videos made for real businesses right here in Florida.</p>
      </div>
    </section>

    <section class="reel-section reel-section-navy">
      <div class="reel-section-inner">
        <div class="reel-grid">
          {portfolioVideos.map((v, i) => (
            <button type="button" class={`portfolio-tile fs-video ${v.orientation}`} aria-label={`Play portfolio video ${i + 1} full screen`}>
              <video preload="none" playsinline poster={`/videos/portfolio/${v.slug}.jpg`}>
                <source src={`/videos/portfolio/${v.slug}.mp4`} type="video/mp4" />
              </video>
              <span class="portfolio-play" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </button>
          ))}
        </div>
        <div class="reel-follow">
          <a href="https://www.instagram.com/shockwave.studios/" target="_blank" rel="noopener" class="reel-follow-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            See more on Instagram
          </a>
        </div>
      </div>
    </section>

    <BottomCTA text="Like what you see? Let's build something for your business." />
  </main>

  <SiteFooter />


  <style>
    :root {
      --bg: #F4F7FC;
      --bg-secondary: #FFFFFF;
      --accent: #A8C5F0;
      --primary: #1B3A6B;
      --secondary: #5B8FD4;
      --text: #1A1A2E;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-weight: 600;
    }

    a { color: inherit; text-decoration: none; }

    h1 {
      font-family: var(--font-impact);
      font-weight: 400;
      letter-spacing: -0.015em;
      color: var(--c-heading);
    }

    h2, h3 {
      font-family: var(--font-editorial);
      font-weight: 700;
      letter-spacing: -0.005em;
      color: var(--c-heading);
    }

    .eyebrow, .subheadline, .badge, .comparison-group-label, th {
      font-family: var(--font-editorial);
    }

    .has-dropdown { position: relative; }

    .dropdown {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background: var(--bg-secondary);
      border: 1px solid rgba(168, 197, 240, 0.15);
      border-radius: 10px;
      min-width: 220px;
      box-shadow: 0 8px 24px rgba(27, 58, 107, 0.12);
      padding: 0.5rem 0;
      list-style: none;
      flex-direction: column;
      z-index: 200;
    }

    .has-dropdown:hover .dropdown { display: flex; }

    .dropdown li a {
      display: block;
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
      color: var(--text);
    }

    .dropdown li a:hover {
      background: rgba(168, 197, 240, 0.08);
      color: var(--accent);
    }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5%;
      height: 88px;
      background: var(--bg);
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid rgba(168, 197, 240, 0.1);
    }

    .logo {
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .logo-link {
      display: flex;
      align-items: center;
      height: 100%;
      overflow: hidden;
    }

    .logo-img {
      height: 192px;
      width: auto;
      display: block;
    }

    .footer-logo-img {
      height: 160px;
      width: auto;
      display: block;
    }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
    }

    .nav-links a {
      font-weight: 500;
      font-size: 0.95rem;
      transition: color 0.2s ease;
    }

    .nav-links a:hover { color: var(--accent); }

    .nav-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
    }

    .nav-toggle span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--text);
    }

    .page-hero {
      background: var(--bg-secondary);
    }

    .page-hero-inner {
      max-width: 800px;
      margin: 0 auto;
      padding: 5rem 5% 3rem;
      text-align: center;
    }

    .page-hero h1 {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }

    .subheadline {
      font-size: 1.15rem;
      color: rgba(26, 26, 46, 0.75);
    }

    .reel-section-navy {
      background: var(--primary);
    }

    .reel-section-inner {
      padding: 1rem 5% 4rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    /* Multi-column so portrait and landscape clips can each keep their own
       shape instead of being cropped to a shared tile ratio. */
    .reel-grid {
      column-count: 3;
      column-gap: 1.5rem;
    }

    .portfolio-tile {
      position: relative;
      display: block;
      width: 100%;
      break-inside: avoid;
      margin: 0 0 1.5rem;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
      border-radius: 12px;
      overflow: hidden;
      line-height: 0;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .portfolio-tile.portrait { aspect-ratio: 9 / 16; }
    .portfolio-tile.landscape { aspect-ratio: 16 / 9; }

    .portfolio-tile:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 40px rgba(27, 58, 107, 0.4);
    }

    .portfolio-tile:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 3px;
    }

    .portfolio-tile video {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      background: #0F2145;
    }

    .portfolio-play {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: rgba(27, 58, 107, 0.75);
      border: 2px solid rgba(255, 255, 255, 0.85);
      color: #FFFFFF;
      padding-left: 3px;
      opacity: 0.9;
      transition: opacity 0.25s ease, transform 0.25s ease;
      pointer-events: none;
    }

    .portfolio-tile:hover .portfolio-play,
    .portfolio-tile:focus-visible .portfolio-play {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.1);
    }

    .reel-follow {
      text-align: center;
      margin-top: 2.5rem;
    }

    .reel-follow-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 1rem 2.5rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 1rem;
      background: var(--accent);
      color: var(--primary);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .reel-follow-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(168, 197, 240, 0.35);
    }

    .reel-follow-btn svg {
      flex-shrink: 0;
    }

    .site-footer {
      padding: 1.5rem 5% 1.25rem;
      border-top: 1px solid rgba(168, 197, 240, 0.1);
      text-align: center;
    }

    .footer-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
    }

    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem 2rem;
    }

    .copyright {
      color: rgba(26, 26, 46, 0.4);
      font-size: 0.85rem;
    }

    @media (max-width: 900px) {
      .reel-grid { column-count: 2; }
    }

    @media (max-width: 768px) {
      .logo-img { height: 144px; }

      .nav-toggle { display: flex; }

      .nav-links {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--bg-secondary);
        flex-direction: column;
        gap: 0;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
      }

      .nav-links.open { max-height: 400px; }

      .nav-links li {
        width: 100%;
        border-top: 1px solid rgba(168, 197, 240, 0.1);
      }

      .nav-links a {
        display: block;
        padding: 1rem 5%;
      }

      .has-dropdown .dropdown {
        display: flex;
        position: static;
        box-shadow: none;
        border: none;
        border-radius: 0;
        background: rgba(168, 197, 240, 0.05);
        padding: 0;
        min-width: unset;
      }

      .dropdown li a { padding-left: 10%; }
    }

    @media (max-width: 600px) {
      .reel-grid { column-count: 1; }
    }
  </style>
  <FullscreenVideo />
</Layout>
