    .journey-panel {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(168, 197, 240, 0.22);
      border-radius: 18px;
      padding: 1.75rem;
      box-shadow: 0 12px 40px rgba(10, 20, 45, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    /* Reveal on scroll is opt-in from the script, so the cards stay
       visible if JavaScript never runs. */
    .journey-panels.js-reveal .journey-panel {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .journey-panels.js-reveal .journey-panel.revealed {
