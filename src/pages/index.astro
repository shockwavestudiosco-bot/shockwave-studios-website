---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BottomCTA from '../components/BottomCTA.astro';
import FullscreenVideo from '../components/FullscreenVideo.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
import { CALENDLY_URL } from '../lib/site';

// Homepage "Our Work" videos. To swap one out: drop the new file in
// public/videos/ (keep it under 20MB for Cloudflare Pages) and change the
// src and label here. Order on the page follows this list.
const workVideos = [
  { slug: "missy-promo",       label: "Service Showcase",    orientation: "portrait" },
  { slug: "driftline-roofing", label: "Talking Head",        orientation: "landscape" },
  { slug: "real-estate",       label: "Real Estate Listing", orientation: "portrait" },
  { slug: "fca-beach",         label: "Event Recap",         orientation: "landscape" },
  { slug: "93-f250",           label: "Vehicle Feature",     orientation: "portrait" },
  { slug: "concrete-day",      label: "On the Job",          orientation: "portrait" },
  { slug: "marlo",             label: "Vlog",                orientation: "landscape" },
  { slug: "pwo",               label: "Event Highlight",     orientation: "portrait" },
  { slug: "hurricane-pools",   label: "Service Walkthrough", orientation: "portrait" },
];

const reviews = [
  {
    name: "Charlie Murray",
    org: "Driftline Roofing",
    quote: "We had the pleasure of working with Ashton at Shockwave Studios, and we couldn't be happier with the experience! Ashton was incredibly professional, easy to work with, and did an amazing job creating a video for our roofing company's website. He was quick to deliver the final product, and the quality exceeded our expectations. Beyond his work, Ashton is just an all-around great person. We highly recommend Shockwave Studios to anyone looking for high-quality video work and a great experience from start to finish!",
  },
  {
    name: "Pure Water Outpost",
    org: "Indoor surf and skate gym",
    quote: "I couldn't be happier with the level of creativity and professionalism. I'll continue to work with Shockwave for all my video marketing needs\nThanks Ashton 🔥",
  },
  {
    name: "Cameron Wickline",
    org: "Fellowship of Christian Athletes",
    quote: "Ashton shot some stuff for the ministry I work for and it was unbelievable!! Definitely a blessing to us. This kid knows what he is doing, listens to the needs of his clients well, and executed exactly what we needed!! Hit him up for anything in the realm of business promotion, not to mention he does other photo/videographer work.",
  },
  {
    name: "Joshua Kelly",
    org: "G37 owner",
    quote: "Ashton was super nice and professional. He was quick and efficient and made a phenomenal video for my car. He was understanding of what I wanted and always asked my input if I would like certain ideas or not. Would recommend 10/10",
  },
  {
    name: "Daniel Lofaso",
    org: "Digital Elevator",
    quote: "I hired Shockwave to help with some social clipper-type content. They are fast, professional, and creative. Highly recommend.",
  },
];

const initials = (name: string) => name.split(/\s+/).slice(0, 2).map(w => w[0]).join('').toUpperCase();
---
<Layout
  title="Shockwave Studios | Social Media Marketing in Melbourne, FL"
  description="Shockwave Studios is a social media marketing agency in Melbourne, Florida offering content, video production, and automation services."
>
  <SiteHeader overlay />

  <main>
    <!-- Showreel hero. Two cuts from the portfolio clips in public/videos:
         a 16:9 one for wide screens and a 9:16 one for phones held upright.
         Each is about 2.7MB, muted, and paused whenever it is off screen.
         No background-image fallback: browsers download every layer. -->
    <section class="hero navy-texture">
      <div class="hero-media" data-parallax="0.18">
        <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/videos/showreel-landscape.jpg" aria-hidden="true" tabindex="-1" data-hero-video>
          <source src="/videos/showreel-portrait.mp4" type="video/mp4" media="(max-width: 768px) and (orientation: portrait)" />
          <source src="/videos/showreel-landscape.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="hero-scrim" aria-hidden="true"></div>

      <div class="hero-inner">
        <p class="eyebrow" data-reveal>Melbourne, Florida</p>
        <h1 data-split>Make Social Media Your <span class="highlight">#1 Source of Leads</span>.</h1>
        <p class="subheadline" data-reveal data-reveal-delay="0.35">We handle the content, strategy, and automation so your social media works for you around the clock.</p>

        <div class="hero-actions" data-reveal data-reveal-delay="0.5" data-sticky-after>
          <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-hero sheen" data-magnetic data-book="book_call_home_hero">
            Book a Free Call
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <p class="hero-note">Free 20-minute call. No commitment.</p>
        </div>

        <!-- Proof at the point of decision. Verbatim from Charlie Murray's
             review below. No star count or review total on purpose: the
             "5.0 stars from 4 reviews" line was removed on 2026-09-03. -->
        <figure class="hero-proof" data-reveal data-reveal-delay="0.7">
          <div class="hero-avatars" aria-hidden="true">
            {reviews.map(r => <span>{initials(r.name)}</span>)}
          </div>
          <div>
            <blockquote>"The quality exceeded our expectations."</blockquote>
            <figcaption>Charlie Murray, Driftline Roofing</figcaption>
          </div>
        </figure>
      </div>

      <a href="#fork" class="scroll-cue" aria-label="Scroll to the next section">
        <span></span>
      </a>
    </section>

    <!-- The two-path fork. Sits directly under the hero on purpose: someone
         landing cold should know which door is theirs before they scroll. -->
    <section class="fork-section" id="fork">
      <div class="fork-inner">
        <p class="fork-question" data-split>Are you here for video marketing, or video production?</p>
        <p class="fork-sub" data-reveal data-reveal-delay="0.3">Two different doors. Pick the one that sounds like you.</p>

        <div class="fork-grid" data-stagger>
          <a href="/video-marketing" class="fork-card" data-track="fork_click" data-track-label="video_marketing">
            <p class="fork-tag">Monthly</p>
            <h3>Video Marketing</h3>
            <p class="fork-desc">Paid ads that sell, plus organic content that makes people believe you. Built to bring you customers every month, not just views.</p>
            <ul class="fork-points">
              <li>Ads carrying your offer to people who have never heard of you</li>
              <li>Organic content that makes the ads credible</li>
              <li>Content pillars built from real competitor data</li>
            </ul>
            <span class="fork-link">
              See how it works
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>

          <a href="/video-production" class="fork-card" data-track="fork_click" data-track-label="video_production">
            <p class="fork-tag">One-off</p>
            <h3>Video Production</h3>
            <p class="fork-desc">You need a video made. Listings, events, brand films, promos. Planned properly first, then shot, edited, and delivered.</p>
            <ul class="fork-points">
              <li>Two calls before anyone picks up a camera</li>
              <li>The plan, scope, and cost shown to you live</li>
              <li>Most projects delivered in under 5 business days</li>
            </ul>
            <span class="fork-link">
              See how it works
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
        </div>

        <p class="fork-note">Not sure which one? <a href="/contact">Tell me what you're after</a> and I'll point you at the right one.</p>
      </div>
    </section>

    <section class="our-work-section" id="work">
      <h2 data-reveal>Our Work</h2>
      <div class="our-work-grid" data-stagger>
        {workVideos.map(v => (
          <div class="work-item">
            <button type="button" class={`work-video-btn fs-video ${v.orientation}`} aria-label={`Play ${v.label} full screen`}>
              <!-- No autoplay: the page script plays each clip only while it
                   is on screen, so nothing downloads until it is needed. -->
              <video muted loop playsinline preload="none" data-loop="true" data-lazy-play poster={`/videos/portfolio/${v.slug}.jpg`}>
                <source src={`/videos/portfolio/${v.slug}.mp4`} type="video/mp4" />
              </video>
              <span class="work-expand" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
              </span>
            </button>
            <p class="work-label">{v.label}</p>
          </div>
        ))}
      </div>
      <a href="/portfolio" class="btn btn-outline-primary work-more" data-reveal>See the Full Portfolio</a>
    </section>

    <!-- Reviews run as a slow marquee on desktop (pauses on hover or focus)
         and a swipeable row on phones. The list is rendered twice for a
         seamless loop; the second copy is hidden from assistive tech. -->
    <section class="results-section">
      <h2 data-reveal>What Clients Say</h2>
      <div class="review-marquee" data-reveal>
        <div class="review-track">
          {[...reviews, ...reviews].map((r, i) => (
            <figure class="review-card" aria-hidden={i >= reviews.length ? 'true' : undefined}>
              <p class="review-stars" aria-label="Rated 5 out of 5 stars">★★★★★</p>
              <blockquote class="review-quote">{r.quote}</blockquote>
              <figcaption class="review-author">
                <span class="review-avatar" aria-hidden="true">{initials(r.name)}</span>
                <span>
                  <span class="review-name">{r.name}</span>
                  <span class="review-org">{r.org}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="video-packages-section">
      <div class="video-packages-inner">
        <h2 data-reveal>Just Need One Video?</h2>
        <div class="video-packages-grid" data-stagger>
          <div class="video-pkg-card">
            <h3>Real Estate Listing</h3>
            <p>A polished walkthrough of your property, filmed and edited to post the same week.</p>
            <p class="video-pkg-price">$300</p>
          </div>
          <div class="video-pkg-card">
            <h3>Event Coverage</h3>
            <p>Full coverage of your event with a recap video and a short highlight reel for social.</p>
            <p class="video-pkg-price">$450</p>
          </div>
          <div class="video-pkg-card">
            <h3>Brand / Promo Video</h3>
            <p>A cinematic 60 to 120 second video built to make people feel something about your business.</p>
            <p class="video-pkg-price">$300</p>
          </div>
        </div>
        <a href="/videography" class="btn btn-outline-primary">See All Packages</a>
      </div>
    </section>

    <BottomCTA text="Your next client is already scrolling. Let's make sure they stop on you." />
  </main>

  <MobileStickyCTA />

  <SiteFooter />

  <style>
    :root {
      --bg: #F4F7FC;
      --bg-secondary: #FFFFFF;
      --accent: #A8C5F0;
      --primary: #1B3A6B;
      --secondary: #5B8FD4;
      --text: #1A1A2E;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-weight: 600;
    }

    a { color: inherit; text-decoration: none; }

    h1 {
      font-family: var(--font-impact);
      font-weight: 400;
      letter-spacing: -0.015em;
      color: var(--c-heading);
    }

    h2, h3 {
      font-family: var(--font-editorial);
      font-weight: 700;
      letter-spacing: -0.005em;
      color: var(--c-heading);
    }

    .eyebrow, .subheadline, .badge, .case-type, .comparison-group-label, th {
      font-family: var(--font-editorial);
    }

    img, video { max-width: 100%; display: block; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.9rem 2rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 1rem;
      transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease, background-color 0.3s ease, color 0.3s ease;
    }

    /* ---------- showreel hero ---------- */

    .hero {
      min-height: min(100svh, 980px);
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--c-ink-navy);
      color: #FFFFFF;
    }

    .hero-media {
      position: absolute;
      inset: -8% 0 0;
      z-index: -3;
    }

    .hero-video {
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
    }

    /* Legibility first: dark at the top for the nav, darkest behind the
       headline, and fading to near-solid navy at the bottom edge. */
    .hero-scrim {
      position: absolute;
      inset: 0;
      z-index: -2;
      background:
        radial-gradient(70% 60% at 50% 50%, rgba(10, 20, 45, 0.55), rgba(10, 20, 45, 0.25) 70%),
        linear-gradient(to bottom, rgba(10, 20, 45, 0.7) 0%, rgba(10, 20, 45, 0.35) 30%, rgba(10, 20, 45, 0.45) 65%, rgba(10, 20, 45, 0.92) 100%);
    }

    /* The texture glow sits above the video but under the text. */
    .hero.navy-texture::before { z-index: -1; opacity: 0.6; }
    .hero.navy-texture::after { z-index: -1; }

    .hero-inner {
      position: relative;
      max-width: 900px;
      margin: 0 auto;
      padding: 9rem 5% 7rem;
      text-align: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--accent);
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-size: 0.8rem;
      margin-bottom: 1.5rem;
    }

    .eyebrow::before, .eyebrow::after {
      content: '';
      width: 28px;
      height: 1px;
      background: currentColor;
      opacity: 0.6;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 6.4vw, 5rem);
      line-height: 1.02;
      letter-spacing: -0.025em;
      margin-bottom: 1.75rem;
      color: #FFFFFF;
      text-wrap: balance;
      text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25);
    }

    .hero h1 .highlight {
      color: var(--accent);
    }

    .subheadline {
      max-width: 620px;
      margin: 0 auto 2.5rem;
      font-size: clamp(1.1rem, 1.8vw, 1.3rem);
      color: rgba(255, 255, 255, 0.86);
      line-height: 1.6;
    }

    .hero-actions {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
    }

    .btn-hero {
      padding: 1.15rem 2.4rem;
      font-size: 1.08rem;
      background: #FFFFFF;
      color: var(--c-navy);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35), 0 0 0 6px rgba(255, 255, 255, 0.08);
    }

    .btn-hero svg { transition: transform 0.35s var(--ease-out); }
    .btn-hero:hover { box-shadow: 0 14px 50px rgba(0, 0, 0, 0.4), 0 0 0 10px rgba(255, 255, 255, 0.1); }
    .btn-hero:hover svg { transform: translateX(4px); }
    .btn-hero:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
    .btn-hero.sheen::after { background: linear-gradient(110deg, transparent 30%, rgba(168, 197, 240, 0.55) 50%, transparent 70%); }

    .hero-note {
      font-size: 0.9rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.7);
    }

    .hero-proof {
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      margin-top: 2.75rem;
      padding: 0.75rem 1.25rem 0.75rem 0.75rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.14);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      text-align: left;
    }

    .hero-avatars { display: flex; }

    .hero-avatars span {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      margin-left: -10px;
      border-radius: 50%;
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--c-navy);
      background: var(--accent);
      border: 2px solid var(--c-ink-navy);
    }

    .hero-avatars span:first-child { margin-left: 0; }
    .hero-avatars span:nth-child(2n) { background: #FFFFFF; }

    .hero-proof blockquote {
      font-family: var(--font-editorial);
      font-style: italic;
      font-weight: 400;
      font-size: 1.02rem;
      color: #FFFFFF;
    }

    .hero-proof figcaption {
      font-size: 0.78rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.65);
    }

    .scroll-cue {
      position: absolute;
      left: 50%;
      bottom: 1.75rem;
      width: 26px;
      height: 42px;
      margin-left: -13px;
      border: 2px solid rgba(255, 255, 255, 0.4);
      border-radius: 999px;
    }

    .scroll-cue span {
      position: absolute;
      left: 50%;
      top: 8px;
      width: 4px;
      height: 8px;
      margin-left: -2px;
      border-radius: 2px;
      background: #FFFFFF;
      animation: cue 1.8s var(--ease-out) infinite;
    }

    @keyframes cue {
      0% { transform: translateY(0); opacity: 0; }
      30% { opacity: 1; }
      100% { transform: translateY(14px); opacity: 0; }
    }

    @media (max-width: 768px) {
      .hero { min-height: 100svh; }
      .hero-inner { padding: 7rem 6% 6rem; }
      .hero-proof { border-radius: 20px; flex-direction: column; text-align: center; gap: 0.6rem; padding: 0.9rem 1.1rem; }
      .scroll-cue { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .scroll-cue span { animation: none; }
    }

    .hero-alt-cta {
      margin-top: 1.25rem;
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.75);
    }

    .hero-alt-cta a {
      color: var(--accent);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .hero-alt-cta a:hover {
      color: #FFFFFF;
    }

    .small-text {
      font-size: 0.95rem;
      color: rgba(26, 26, 46, 0.55);
      margin-bottom: 2rem;
    }

    section h2 {
      text-align: center;
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      font-weight: 800;
      margin-bottom: 3rem;
      letter-spacing: -0.02em;
    }

    /* ---------- two-path fork ---------- */

    .fork-section {
      background: var(--bg-secondary);
      padding: var(--space-section) 5%;
      border-bottom: 1px solid rgba(168, 197, 240, 0.15);
    }

    .fork-inner {
      max-width: 1050px;
      margin: 0 auto;
      text-align: center;
    }

    .fork-question {
      font-family: var(--font-impact);
      font-weight: 400;
      font-size: clamp(1.5rem, 3.6vw, 2.6rem);
      line-height: 1.18;
      letter-spacing: -0.01em;
      color: var(--primary);
      margin-bottom: 1rem;
    }

    .fork-sub {
      font-family: var(--font-editorial);
      font-style: italic;
      font-weight: 400;
      font-size: clamp(1rem, 2vw, 1.25rem);
      color: rgba(26, 26, 46, 0.66);
      margin-bottom: 3rem;
    }

    .fork-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      text-align: left;
    }

    .fork-card {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      /* Spotlight: --mx/--my follow the cursor (set by the page script), so a
         soft blue light tracks the pointer across the card. */
      background:
        radial-gradient(420px circle at var(--mx, 50%) var(--my, -20%), rgba(91, 143, 212, 0.14), transparent 60%),
        var(--bg);
      border: 1px solid var(--c-line);
      border-radius: var(--r-lg);
      padding: 2.75rem 2.5rem;
      box-shadow: var(--shadow-sm);
      transition: transform 0.5s var(--ease-out), box-shadow 0.5s ease, border-color 0.3s ease;
    }

    .fork-card:hover {
      transform: translateY(-8px);
      border-color: rgba(91, 143, 212, 0.45);
      box-shadow: var(--shadow-lg);
    }

    .fork-tag {
      align-self: flex-start;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #ffffff;
      background: var(--primary);
      border-radius: 999px;
      padding: 0.35rem 0.9rem;
    }

    .fork-card h3 {
      font-size: clamp(1.4rem, 3vw, 2rem);
      line-height: 1.15;
      color: var(--primary);
    }

    .fork-desc {
      font-size: 1.05rem;
      line-height: 1.6;
      color: rgba(26, 26, 46, 0.72);
    }

    .fork-points {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin: 0.25rem 0 0.5rem;
      padding: 0;
      flex-grow: 1;
    }

    .fork-points li {
      position: relative;
      padding-left: 1.4rem;
      font-size: 0.98rem;
      line-height: 1.5;
      color: rgba(26, 26, 46, 0.66);
    }

    .fork-points li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--secondary);
    }

    .fork-link {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: auto;
      padding-top: 1.25rem;
      border-top: 1px solid rgba(168, 197, 240, 0.35);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--primary);
    }

    .fork-link svg {
      transition: transform 0.25s ease;
    }

    .fork-card:hover .fork-link svg {
      transform: translateX(4px);
    }

    .fork-note {
      margin-top: 2.5rem;
      font-size: 0.98rem;
      color: rgba(26, 26, 46, 0.55);
    }

    .fork-note a {
      color: var(--secondary);
      font-weight: 700;
      text-decoration: underline;
