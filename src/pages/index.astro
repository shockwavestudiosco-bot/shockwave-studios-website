      }

      .hero-inner {
        padding: 4rem 5% 3rem;
      }

      .journey-section {
        padding: 3.5rem 5%;
      }

      .pin-dot {
        width: 28px;
        height: 28px;
        font-size: 0.75rem;
      }

      .pin-label {
        font-size: 0.6rem;
      }

      .journey-panels {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    // The map draws itself once when it scrolls into view. The page scrolls
    // normally; nothing is pinned and nothing is driven by scroll position.
    const svg = document.querySelector('.journey-svg');
    const progressPath = document.querySelector('.route-progress');
    const trailPath = document.querySelector('.route-trail');
    const mapEl = document.querySelector('.journey-map');
    const flag = document.querySelector('.journey-flag');
    const pins = [...document.querySelectorAll('.journey-pin')];
    const panelWrap = document.querySelector('.journey-panels');
    const panels = [...document.querySelectorAll('.journey-panel')];

    if (svg && progressPath && trailPath && mapEl) {
      const pathLength = progressPath.getTotalLength();
      // Bright head: a short glowing segment that rides the tip of the route
      const HEAD_LEN = pathLength * 0.08;
      const stopFractions = [0.001, 0.3, 0.6, 0.88];

      trailPath.style.strokeDasharray = String(pathLength);
      progressPath.style.strokeDasharray = `${HEAD_LEN} ${pathLength}`;

      function placePins() {
        const vb = svg.viewBox.baseVal;
        pins.forEach((pin, i) => {
          const pt = progressPath.getPointAtLength(stopFractions[i] * pathLength);
          pin.style.left = (pt.x / vb.width) * 100 + '%';
          pin.style.top = (pt.y / vb.height) * 100 + '%';
        });
        if (flag) {
          const end = progressPath.getPointAtLength(pathLength);
          flag.style.left = (end.x / vb.width) * 100 + '%';
          flag.style.top = (end.y / vb.height) * 100 + '%';
        }
      }
      placePins();
      window.addEventListener('resize', placePins);

      function draw(progress) {
        const drawn = progress * pathLength;
        trailPath.style.strokeDashoffset = String(pathLength - drawn);
        progressPath.style.strokeDashoffset = String(HEAD_LEN - drawn);
        pins.forEach((pin, i) => pin.classList.toggle('reached', progress >= stopFractions[i] - 0.05));
        if (flag) flag.classList.toggle('show', progress >= 0.94);
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        draw(1);
      } else {
        draw(0);
        if (panelWrap) panelWrap.classList.add('js-reveal');

        const DURATION = 2200;
        let started = false;
        const mapObserver = new IntersectionObserver((entries) => {
          if (started || !entries.some(e => e.isIntersecting)) return;
          started = true;
          mapObserver.disconnect();
          const t0 = performance.now();
          (function step(now) {
            const t = Math.min(1, (now - t0) / DURATION);
            const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
            draw(eased);
            if (t < 1) requestAnimationFrame(step);
          })(t0);
        }, { threshold: 0.35 });
        mapObserver.observe(mapEl);

        const panelObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.style.transitionDelay = (panels.indexOf(entry.target) % 2) * 0.1 + 's';
            entry.target.classList.add('revealed');
            panelObserver.unobserve(entry.target);
          });
        }, { threshold: 0.2 });
        panels.forEach(p => panelObserver.observe(p));
      }
    }
  </script>

