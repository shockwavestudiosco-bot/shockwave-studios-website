      color: var(--accent);
      transform: translate(-85%, -110%) scale(0);
      transform-origin: bottom right;
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .journey-flag.show {
      transform: translate(-85%, -110%) scale(1.15);
    }

    .flag-label {
