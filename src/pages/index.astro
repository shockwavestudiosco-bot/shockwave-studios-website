    /* --- What We Do journey map (normal document flow, no scroll pinning) --- */
    .journey-section {
      padding: 5rem 5%;
      overflow-x: clip;
    }

    .journey-intro {
      max-width: 720px;
      margin: 0 auto 3rem;
