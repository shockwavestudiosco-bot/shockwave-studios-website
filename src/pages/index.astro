---
import Layout from '../layouts/Layout.astro';
import BottomCTA from '../components/BottomCTA.astro';
import ResearchedCall from '../components/ResearchedCall.astro';
import InstagramLink from '../components/InstagramLink.astro';
const navLinks = [
  { href: "/services", label: "Services" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const reviews = [
  {
    name: "Charlie Murray",
    org: "Driftline Roofing",
    quote: "We had the pleasure of working with Ashton at Shockwave Studios, and we couldn't be happier with the experience! Ashton was incredibly professional, easy to work with, and did an amazing job creating a video for our roofing company's website. He was quick to deliver the final product, and the quality exceeded our expectations. Beyond his work, Ashton is just an all-around great person. We highly recommend Shockwave Studios to anyone looking for high-quality video work and a great experience from start to finish!",
  },
  {
    name: "Cameron Wickline",
    org: "Fellowship of Christian Athletes",
    quote: "Ashton shot some stuff for the ministry I work for and it was unbelievable!! Definitely a blessing to us. This kid knows what he is doing, listens to the needs of his clients well, and executed exactly what we needed!! Hit him up for anything in the realm of business promotion, not to mention he does other photo/videographer work.",
  },
  {
    name: "Joshua Kelly",
    org: "G37 owner",
    quote: "Ashton was super nice and professional. He was quick and efficient and made a phenomenal video for my car. He was understanding of what I wanted and always asked my input if I would like certain ideas or not. Would recommend 10/10",
  },
  {
    name: "Daniel Lofaso",
    org: "Digital Elevator",
    quote: "I hired Shockwave to help with some social clipper-type content. They are fast, professional, and creative. Highly recommend.",
  },
];
---
<Layout
  title="Shockwave Studios | Social Media Marketing in Melbourne, FL"
  description="Shockwave Studios is a social media marketing agency in Melbourne, Florida offering content, video production, and automation services."
>
  <header class="site-header">
    <a href="/" class="logo-link" aria-label="Shockwave Studios home">
      <img src="/shockwave-studios/logo.svg" alt="Shockwave Studios" class="logo-img" />
    </a>
    <nav class="nav">
      <button class="nav-toggle" aria-label="Toggle menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links">
        <li class="has-dropdown">
          <a href="/services">Services</a>
          <ul class="dropdown">
            <li><a href="/services">Lead Generation</a></li>
            <li><a href="/videography">Video Production</a></li>
          </ul>
        </li>
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-glow"></div>
        <p class="eyebrow">Melbourne, Florida</p>
        <h1>Make Social Media Your <span class="highlight">#1 Source of Leads</span>.</h1>
        <p class="subheadline">We handle the content, strategy, and automation so your social media works for you around the clock.</p>
        <a href="https://calendly.com/shockwavestudios-co/30min" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Book a Free Call</a>
      </div>
    </section>

    <section class="our-work-section">
      <h2>Our Work</h2>
      <div class="our-work-grid">
        <div class="work-item">
          <video autoplay muted loop playsinline>
            <source src="/videos/video-1.mp4" type="video/mp4" />
          </video>
          <p class="work-label">Speaker Event Edit</p>
        </div>
        <div class="work-item">
          <video autoplay muted loop playsinline>
            <source src="/videos/video-2.mp4" type="video/mp4" />
          </video>
          <p class="work-label">Event Recap</p>
        </div>
        <div class="work-item">
          <video autoplay muted loop playsinline>
            <source src="/videos/video-3.mp4" type="video/mp4" />
          </video>
          <p class="work-label">Premium Listing Video</p>
        </div>
      </div>
    </section>

    <section class="services-section journey-section" id="what-we-do">
      <div class="journey-track">
        <div class="journey-sticky">
          <h2>What We Do</h2>

          <div class="journey-intro">
            <div class="journey-intro-bubble">
              <p>We handle everything social media for your business so you can sit back and focus on providing a great service while we generate you leads.</p>
              <p class="journey-intro-kicker">Here's exactly what we do</p>
              <svg class="journey-intro-arrow" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
            </div>
          </div>

          <div class="journey-map">
            <div class="journey-world">
              <svg class="journey-svg" viewBox="0 0 1000 380" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path class="route-bg" d="M 50 300 C 200 60, 300 60, 420 180 S 620 340, 750 220 S 900 60, 950 80" />
                <path class="route-trail" d="M 50 300 C 200 60, 300 60, 420 180 S 620 340, 750 220 S 900 60, 950 80" />
                <path class="route-progress" d="M 50 300 C 200 60, 300 60, 420 180 S 620 340, 750 220 S 900 60, 950 80" />
              </svg>
              <div class="journey-pin" data-stop="0"><span class="pin-dot">1</span><span class="pin-label">Audit</span></div>
              <div class="journey-pin" data-stop="1"><span class="pin-dot">2</span><span class="pin-label">Strategy</span></div>
              <div class="journey-pin" data-stop="2"><span class="pin-dot">3</span><span class="pin-label">Create</span></div>
              <div class="journey-pin" data-stop="3"><span class="pin-dot">4</span><span class="pin-label">Automate</span></div>
              <div class="journey-flag">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                <span class="flag-label">#1 Lead Source</span>
              </div>
            </div>
          </div>

          <div class="journey-box">
          <div class="journey-panels">
            <div class="journey-panel" data-stop="0">
              <p class="journey-step">Stop 1 of 4</p>
              <h3>Audit & Optimize Your Page</h3>
              <p>First stop: we tear down your page and rebuild it for lead generation. Bio, highlights, link, profile photo, every inch of your profile gets optimized so visitors turn into followers and followers turn into customers.</p>
            </div>
            <div class="journey-panel" data-stop="1">
              <p class="journey-step">Stop 2 of 4</p>
              <h3>Build Your Strategy</h3>
              <p>Next, we build your content strategy around your plan. Who you're talking to, what they care about, and what makes them stop scrolling, all turned into a repeatable system so your page always has a direction, not just random posts.</p>
            </div>
            <div class="journey-panel" data-stop="2">
              <p class="journey-step">Stop 3 of 4</p>
              <h3>Script, Shoot & Edit</h3>
              <p>Then we batch-script the entire month's content, show up with the camera and film it, and edit every video to perform on social, not just to look pretty.</p>
            </div>
            <div class="journey-panel" data-stop="3">
              <p class="journey-step">Stop 4 of 4</p>
              <h3>Schedule & Automate</h3>
              <p>Final stop: everything gets scheduled so your page stays consistent without you lifting a finger, and automated DM flows turn comments into leads 24/7, even while you sleep.</p>
              <p class="journey-destination">Destination reached: social media is now your #1 source of leads.</p>
              <a href="https://calendly.com/shockwavestudios-co/30min" target="_blank" rel="noopener noreferrer" class="btn journey-cta">Book a Free Call</a>
            </div>
          </div>
          <div class="journey-bar" aria-hidden="true">
            <div class="journey-bar-fill"></div>
            <span class="journey-bar-notch" style="left: 33.3%"></span>
            <span class="journey-bar-notch" style="left: 66.6%"></span>
          </div>
          </div>
        </div>
      </div>
    </section>

    <section class="results-section">
      <h2>What Clients Say</h2>
      <p class="results-subhead">5.0 stars from 4 reviews on Google.</p>
      <div class="review-grid">
        {reviews.map(r => (
          <figure class="review-card">
            <p class="review-stars" aria-label="Rated 5 out of 5 stars">★★★★★</p>
            <blockquote class="review-quote">{r.quote}</blockquote>
            <figcaption class="review-author">
              <span class="review-name">{r.name}</span>
              <span class="review-org">{r.org}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="video-packages-section">
      <div class="video-packages-inner">
        <h2>Just Need One Video?</h2>
        <div class="video-packages-grid">
          <div class="video-pkg-card">
            <h3>Real Estate Listing</h3>
            <p>A polished walkthrough of your property, filmed and edited to post the same week.</p>
            <p class="video-pkg-price">$300</p>
          </div>
          <div class="video-pkg-card">
            <h3>Event Coverage</h3>
            <p>Full coverage of your event with a recap video and a short highlight reel for social.</p>
            <p class="video-pkg-price">$450</p>
          </div>
          <div class="video-pkg-card">
            <h3>Brand / Promo Video</h3>
            <p>A cinematic 60 to 120 second video built to make people feel something about your business.</p>
            <p class="video-pkg-price">$300</p>
          </div>
        </div>
        <a href="/videography" class="btn btn-outline-primary">See All Packages</a>
      </div>
    </section>

    <ResearchedCall />

    <BottomCTA text="Your next client is already scrolling. Let's make sure they stop on you." />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <a href="/" class="logo-link" aria-label="Shockwave Studios home">
        <img src="/shockwave-studios/logo.svg" alt="Shockwave Studios" class="footer-logo-img" />
      </a>
      <ul class="nav-links footer-links">
        {navLinks.map(link => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <InstagramLink />
    </div>
    <p class="copyright">&copy; {new Date().getFullYear()} Shockwave Studios. Melbourne, Florida.</p>
  </footer>

  <style>
    :root {
      --bg: #F4F7FC;
      --bg-secondary: #FFFFFF;
      --accent: #A8C5F0;
      --primary: #1B3A6B;
      --secondary: #5B8FD4;
      --text: #1A1A2E;
    }

    @font-face {
      font-family: 'Monument Extended';
      src: url('/fonts/MonumentExtended-Regular.otf') format('opentype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: 'Monument Extended';
      src: url('/fonts/MonumentExtended-Ultrabold.otf') format('opentype');
      font-weight: 800;
      font-style: normal;
      font-display: swap;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      scroll-behavior: smooth;
    }

    a { color: inherit; text-decoration: none; }

    h1, h2, h3 {
      font-family: 'Monument Extended', sans-serif;
      font-weight: 800;
      letter-spacing: 0.02em;
      color: #6B9FD4;
    }

    .eyebrow, .subheadline, .badge, .case-type, .comparison-group-label, th {
      font-family: 'Playfair Display', serif;
    }

    img, video { max-width: 100%; display: block; }

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5%;
      height: 88px;
      background: var(--bg);
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid rgba(168, 197, 240, 0.1);
    }

    .logo {
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .logo-link {
      display: flex;
      align-items: center;
      height: 100%;
      overflow: hidden;
    }

    .logo-img {
      height: 192px;
      width: auto;
      display: block;
    }

    .footer-logo-img {
      height: 160px;
      width: auto;
      display: block;
    }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
    }

    .nav-links a {
      font-weight: 500;
      font-size: 0.95rem;
      transition: color 0.2s ease;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .has-dropdown { position: relative; }

    .dropdown {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      background: var(--bg-secondary);
      border: 1px solid rgba(168, 197, 240, 0.15);
      border-radius: 10px;
      min-width: 220px;
      box-shadow: 0 8px 24px rgba(27, 58, 107, 0.12);
      padding: 0.5rem 0;
      list-style: none;
      flex-direction: column;
      z-index: 200;
    }

    .has-dropdown:hover .dropdown { display: flex; }

    .dropdown li a {
      display: block;
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
      color: var(--text);
    }

    .dropdown li a:hover {
      background: rgba(168, 197, 240, 0.08);
      color: var(--accent);
    }

    .nav-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
    }

    .nav-toggle span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--text);
    }

    .btn {
      display: inline-block;
      padding: 0.9rem 2rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 1rem;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-primary {
      background: var(--primary);
      color: #FFFFFF;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(168, 197, 240, 0.25);
    }

    .hero {
      position: relative;
      background-image: url('/hero-bg.jpg');
      background-size: cover;
      background-position: right 50%;
      background-repeat: no-repeat;
    }

    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(10, 20, 45, 0.6) 0%, rgba(10, 20, 45, 0.75) 100%);
      z-index: 0;
    }

    .hero-inner {
      position: relative;
      z-index: 1;
      max-width: 800px;
      margin: 0 auto;
      padding: 8rem 5% 7rem;
      text-align: center;
      animation: fadeUp 0.8s ease both;
    }

    .hero-glow {
      display: none;
    }

    .eyebrow {
      color: var(--accent);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.85rem;
      margin-bottom: 1.25rem;
    }

    .hero h1 {
      font-size: clamp(2.2rem, 5vw, 3.6rem);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 1.5rem;
      color: #ffffff;
    }

    .hero h1 .highlight {
      color: var(--accent);
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .subheadline {
      font-size: 1.2rem;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 0.75rem;
      line-height: 1.6;
    }

    .hero-alt-cta {
      margin-top: 1.25rem;
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.75);
    }

    .hero-alt-cta a {
      color: var(--accent);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .hero-alt-cta a:hover {
      color: #FFFFFF;
    }

    .small-text {
      font-size: 0.95rem;
      color: rgba(26, 26, 46, 0.55);
      margin-bottom: 2rem;
    }

    section h2 {
      text-align: center;
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      font-weight: 800;
      margin-bottom: 3rem;
      letter-spacing: -0.02em;
    }

    .our-work-section {
      padding: 5rem 5%;
      background: var(--bg);
      text-align: center;
    }

    .our-work-section h2 {
      color: var(--primary);
      margin-bottom: 3rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .our-work-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .work-item {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .work-item video {
      width: 100%;
      aspect-ratio: 9 / 16;
      object-fit: cover;
      border-radius: 12px;
      border: 1px solid rgba(168, 197, 240, 0.2);
    }

    .work-label {
      font-family: 'Monument Extended', sans-serif;
      font-weight: 800;
      font-size: 0.9rem;
      color: var(--primary);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
    }

    .services-section, .results-section {
      padding: 5rem 5%;
    }

    .services-section {
      background: var(--primary);
      color: #FFFFFF;
    }

    .services-section h2 {
      color: var(--accent);
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      -webkit-text-stroke: 0.5px var(--accent);
    }

    .services-subheader {
      text-align: center;
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 1.4rem;
      color: rgba(255, 255, 255, 0.75);
      margin-top: -0.5rem;
      margin-bottom: 3rem;
    }

    .results-section {
      background: var(--bg-secondary);
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .card {
      background: var(--bg-secondary);
      border: 1px solid rgba(168, 197, 240, 0.1);
      border-radius: 16px;
      padding: 2.25rem;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .card:hover {
      transform: translateY(-6px);
      border-color: rgba(168, 197, 240, 0.35);
      box-shadow: 0 16px 40px rgba(27, 58, 107, 0.35);
    }

    .card-icon {
      color: var(--accent);
      margin-bottom: 1rem;
    }

    .card h3 {
      font-size: 1.3rem;
      margin-bottom: 0.9rem;
      color: var(--accent);
    }

    .card p {
      font-weight: 600;
      line-height: 1.6;
      color: rgba(26, 26, 46, 0.85);
    }

    .results-subhead {
      text-align: center;
      color: rgba(26, 26, 46, 0.6);
      font-weight: 600;
      margin-top: -0.5rem;
      margin-bottom: 3rem;
    }

    .review-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      align-items: start;
      gap: 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .review-card {
      background: var(--bg);
      border: 1px solid rgba(168, 197, 240, 0.15);
      border-radius: 16px;
      padding: 2.25rem;
      margin: 0;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .review-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(27, 58, 107, 0.35);
    }

    .review-stars {
      color: #E8A33D;
      font-size: 1.1rem;
      letter-spacing: 0.15em;
      margin-bottom: 1rem;
    }

    .review-quote {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 1.05rem;
      line-height: 1.6;
      color: rgba(26, 26, 46, 0.85);
      margin: 0 0 1.5rem;
    }

    .review-author {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .review-name {
      font-weight: 700;
      color: var(--primary);
    }

    .review-org {
      font-size: 0.9rem;
      color: rgba(26, 26, 46, 0.6);
    }

    .video-packages-section {
      background: var(--bg);
      padding: 5rem 5%;
    }

    .video-packages-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .video-packages-inner h2 {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.75rem;
    }

    .video-packages-sub {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 1.15rem;
      color: rgba(26, 26, 46, 0.6);
      margin-bottom: 3rem;
      text-align: center;
    }

    .video-packages-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      width: 100%;
      margin-bottom: 2.5rem;
    }

    .video-pkg-card {
      background: var(--bg-secondary);
      border: 1px solid rgba(168, 197, 240, 0.1);
      border-radius: 16px;
      padding: 2.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .video-pkg-card:hover {
      transform: translateY(-6px);
      border-color: rgba(168, 197, 240, 0.35);
      box-shadow: 0 16px 40px rgba(27, 58, 107, 0.15);
    }

    .video-pkg-card h3 {
      font-size: 1.05rem;
      color: var(--primary);
    }

    .video-pkg-card p {
      font-size: 0.92rem;
      color: rgba(26, 26, 46, 0.7);
      line-height: 1.55;
      flex-grow: 1;
      font-weight: 400;
    }

    .video-pkg-price {
      font-size: 1.1rem !important;
      font-weight: 800 !important;
      color: var(--primary) !important;
      flex-grow: 0 !important;
      padding-top: 0.5rem;
      border-top: 1px solid rgba(168, 197, 240, 0.2);
    }

    .btn-outline-primary {
      background: transparent;
      color: var(--primary);
      border: 2px solid var(--primary);
    }

    .btn-outline-primary:hover {
      background: var(--primary);
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(27, 58, 107, 0.2);
    }

    .site-footer {
      padding: 1.5rem 5% 1.25rem;
      border-top: 1px solid rgba(168, 197, 240, 0.1);
      text-align: center;
    }

    .footer-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
    }

    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem 2rem;
    }

    .copyright {
      color: rgba(26, 26, 46, 0.4);
      font-size: 0.85rem;
    }

    /* --- What We Do journey map --- */
    .journey-section {
      padding: 0;
    }

    .journey-track {
      height: 450vh;
      position: relative;
    }

    .journey-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 4.5rem 5% 2rem;
      overflow: hidden;
    }

    .journey-sticky h2 {
      margin-bottom: 0.5rem;
    }

    .journey-sticky .services-subheader {
      margin-bottom: 1.5rem;
    }

    /* Intro bubble: greets you before the map journey begins */
    .journey-intro {
      position: absolute;
      inset: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 5%;
      pointer-events: none;
    }

    .journey-intro-bubble {
      max-width: 720px;
      text-align: center;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(168, 197, 240, 0.3);
      border-radius: 32px;
      padding: 3rem 3.5rem 2.5rem;
      backdrop-filter: blur(10px);
      box-shadow: 0 20px 60px rgba(10, 20, 45, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .journey-intro-bubble p {
      font-size: clamp(1.15rem, 2.2vw, 1.5rem);
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.92);
      font-weight: 600;
    }

    .journey-intro-kicker {
      margin-top: 1.25rem;
      font-family: 'Playfair Display', serif;
      font-style: italic;
      color: var(--accent) !important;
      font-size: 1.2rem !important;
      font-weight: 500 !important;
    }

    .journey-intro-arrow {
      color: var(--accent);
      margin: 0.75rem auto 0;
      display: block;
      animation: introArrowBounce 1.6s ease-in-out infinite;
    }

    @keyframes introArrowBounce {
      0%, 100% { transform: translateY(0); opacity: 0.7; }
      50% { transform: translateY(8px); opacity: 1; }
    }

    .journey-map {
      position: relative;
      max-width: 900px;
      width: 100%;
      margin: 0 auto;
      aspect-ratio: 1000 / 380;
      overflow: hidden;
    }

    /* Edges melt into the navy background instead of cutting off */
    .journey-map::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 5;
      background:
        linear-gradient(to right, var(--primary), transparent 14%, transparent 86%, var(--primary)),
        linear-gradient(to bottom, var(--primary), transparent 18%, transparent 82%, var(--primary));
    }

    /* World is rendered at full zoom size so nothing gets upscaled (stays crisp);
       the camera only translates it. Size must match CAM_ZOOM in the script. */
    .journey-world {
      position: absolute;
      top: 0;
      left: 0;
      width: 240%;
      height: 240%;
      transform-origin: 0 0;
      will-change: transform;
    }

    .journey-svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .route-bg, .route-trail, .route-progress {
      fill: none;
      stroke-width: 3;
      stroke-linecap: round;
    }

    /* What's coming up: faint dashed route ahead */
    .route-bg {
      stroke: rgba(168, 197, 240, 0.14);
      stroke-dasharray: 2 10;
    }

    /* What we passed: dim solid trail */
    .route-trail {
      stroke: rgba(168, 197, 240, 0.35);
    }

    /* Where we are: bright glowing head at the tip */
    .route-progress {
      stroke: var(--accent);
      filter: drop-shadow(0 0 8px rgba(168, 197, 240, 0.85));
    }

    .journey-pin {
      position: absolute;
      transform: translate(-50%, -50%) scale(1.15);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }

    .pin-dot {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(27, 58, 107, 0.9);
      border: 2px solid rgba(168, 197, 240, 0.35);
      color: rgba(255, 255, 255, 0.5);
      font-weight: 800;
      font-family: 'Monument Extended', sans-serif;
      font-size: 0.9rem;
      transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    }

    .pin-label {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.45);
      transition: color 0.3s ease;
    }

    .journey-pin.reached .pin-dot {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--primary);
    }

    .journey-pin.reached .pin-label {
      color: var(--accent);
    }

    .journey-pin.active .pin-dot {
      transform: scale(1.25);
      box-shadow: 0 0 24px rgba(168, 197, 240, 0.8);
    }

    .journey-box {
      position: relative;
      max-width: 680px;
      margin: 1.75rem auto 0;
      width: 100%;
      padding: 1.4rem 2rem 1.25rem;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(168, 197, 240, 0.22);
      border-radius: 18px;
      backdrop-filter: blur(8px);
      box-shadow: 0 12px 40px rgba(10, 20, 45, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.06);
      overflow: hidden;
    }

    /* soft accent sheen sweeping the box */
    .journey-box::before {
      content: '';
      position: absolute;
      top: 0;
      left: -60%;
      width: 40%;
      height: 100%;
      background: linear-gradient(105deg, transparent, rgba(168, 197, 240, 0.07), transparent);
      animation: boxSheen 5s ease-in-out infinite;
      pointer-events: none;
    }

    @keyframes boxSheen {
      0%, 60% { left: -60%; }
      100% { left: 120%; }
    }

    .journey-panels {
      position: relative;
      min-height: 250px;
      width: 100%;
    }

    .journey-panel {
      position: absolute;
      inset: 0;
      text-align: center;
      opacity: 0;
      pointer-events: none;
    }

    .journey-panel > * {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .journey-panel.active {
      opacity: 1;
    }

    /* staggered reveal: step, then title, then blurb */
    .journey-panel.active > * {
      opacity: 1;
      transform: translateY(0);
    }
    .journey-panel.active > .journey-step { transition-delay: 0.05s; }
    .journey-panel.active > h3 { transition-delay: 0.15s; }
    .journey-panel.active > p { transition-delay: 0.25s; }
    .journey-panel.active > .journey-destination { transition-delay: 0.4s; }
    .journey-panel.active > .journey-cta { transition-delay: 0.55s; }

    .journey-destination {
      margin-top: 0.6rem;
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 1.1rem;
      color: var(--accent) !important;
    }

    .journey-cta {
      display: inline-block;
      margin-top: 0.75rem;
      padding: 0.65rem 1.6rem;
      font-size: 0.92rem;
      background: var(--accent);
      color: var(--primary);
      pointer-events: auto;
    }

    .journey-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(168, 197, 240, 0.4);
    }

    .journey-flag {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      color: var(--accent);
      transform: translate(-30%, -110%) scale(0);
      transform-origin: bottom left;
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .journey-flag.show {
      transform: translate(-30%, -110%) scale(1.15);
    }

    .flag-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .journey-bar {
      position: relative;
      margin-top: 1.4rem;
      height: 6px;
      border-radius: 999px;
      background: rgba(168, 197, 240, 0.15);
      overflow: hidden;
    }

    .journey-bar-fill {
      position: absolute;
      inset: 0 auto 0 0;
      width: 0%;
      border-radius: 999px;
      background: linear-gradient(90deg, rgba(168, 197, 240, 0.55), var(--accent));
      box-shadow: 0 0 12px rgba(168, 197, 240, 0.7);
    }

    .journey-bar-notch {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 2px;
      background: rgba(27, 58, 107, 0.9);
    }

    .journey-step {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      color: rgba(255, 255, 255, 0.6);
      margin-bottom: 0.5rem;
    }

    .journey-panel h3 {
      color: var(--accent);
      font-size: 1.35rem;
      margin-bottom: 0.75rem;
    }

    .journey-panel p:last-child {
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.6;
      font-weight: 500;
    }

    @media (prefers-reduced-motion: reduce) {
      .journey-panel, .pin-dot, .pin-label, .journey-pin .pin-dot {
        transition: none;
      }
    }

    @media (max-width: 768px) {
      .logo-img { height: 144px; }

      .nav-toggle { display: flex; }

      .nav-links {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--bg-secondary);
        flex-direction: column;
        gap: 0;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
      }

      .nav-links.open {
        max-height: 400px;
      }

      .nav-links li {
        width: 100%;
        border-top: 1px solid rgba(168, 197, 240, 0.1);
      }

      .nav-links a {
        display: block;
        padding: 1rem 5%;
      }

      .our-work-grid {
        grid-template-columns: 1fr;
      }

      .card-grid {
        grid-template-columns: 1fr;
      }

      .review-grid {
        grid-template-columns: 1fr;
      }

      .video-packages-grid {
        grid-template-columns: 1fr;
      }

      .hero-inner {
        padding: 4rem 5% 3rem;
      }

      .journey-track {
        height: 350vh;
      }

      .journey-sticky {
        padding: 3.5rem 5% 1.5rem;
        justify-content: flex-start;
      }

      .pin-dot {
        width: 28px;
        height: 28px;
        font-size: 0.75rem;
      }

      .pin-label {
        font-size: 0.6rem;
      }

      .journey-panels {
        min-height: 260px;
      }
    }
  </style>

  <script>
    const track = document.querySelector('.journey-track');
    const progressPath = document.querySelector('.route-progress');
    const svg = document.querySelector('.journey-svg');
    const map = document.querySelector('.journey-map');
    const world = document.querySelector('.journey-world');
    const pins = [...document.querySelectorAll('.journey-pin')];
    const panels = [...document.querySelectorAll('.journey-panel')];
    const CAM_ZOOM = 2.4;

    const trailPath = document.querySelector('.route-trail');
    const barFill = document.querySelector('.journey-bar-fill');
    const intro = document.querySelector('.journey-intro');
    const box = document.querySelector('.journey-box');
    // First 18% of the scroll is the intro bubble; the map journey uses the rest
    const INTRO_END = 0.18;

    if (track && progressPath && trailPath && svg) {
      const pathLength = progressPath.getTotalLength();
      // Bright head: a short glowing segment that rides the tip of the route
      const HEAD_LEN = pathLength * 0.08;
      trailPath.style.strokeDasharray = String(pathLength);
      trailPath.style.strokeDashoffset = String(pathLength);
      progressPath.style.strokeDasharray = `${HEAD_LEN} ${pathLength}`;
      progressPath.style.strokeDashoffset = String(HEAD_LEN);

      // Pins along the route, with the finish flag past the last stop
      const stopFractions = [0.001, 0.3, 0.6, 0.88];
      const flag = document.querySelector('.journey-flag');

      function placePins() {
        const vb = svg.viewBox.baseVal;
        pins.forEach((pin, i) => {
          const pt = progressPath.getPointAtLength(stopFractions[i] * pathLength);
          pin.style.left = (pt.x / vb.width) * 100 + '%';
          pin.style.top = (pt.y / vb.height) * 100 + '%';
        });
        if (flag) {
          const end = progressPath.getPointAtLength(pathLength);
          flag.style.left = (end.x / vb.width) * 100 + '%';
          flag.style.top = (end.y / vb.height) * 100 + '%';
        }
      }
      placePins();

      let activeStop = -1;
      let target = 0;   // raw scroll progress
      let current = 0;  // smoothed progress the visuals follow

      function readScroll() {
        const rect = track.getBoundingClientRect();
        const scrollable = rect.height - window.innerHeight;
        target = Math.min(1, Math.max(0, -rect.top / scrollable));
      }

      function render(rawProgress) {
        // Intro bubble fades out as the map fades in
        const introT = Math.min(1, rawProgress / INTRO_END);
        if (intro) {
          intro.style.opacity = String(1 - introT);
          intro.style.transform = `translateY(${introT * -40}px) scale(${1 - introT * 0.06})`;
          intro.style.visibility = introT >= 1 ? 'hidden' : 'visible';
        }
        // Map stays fully hidden until the intro bubble is scrolled through
        map.style.opacity = String(introT);
        if (box) box.style.opacity = String(introT);

        const progress = Math.min(1, Math.max(0, (rawProgress - INTRO_END) / (1 - INTRO_END)));
        const drawn = progress * pathLength;

        // Dim trail behind us, bright head at the tip
        trailPath.style.strokeDashoffset = String(pathLength - drawn);
        progressPath.style.strokeDashoffset = String(HEAD_LEN - drawn);

        // Camera: follow the tip of the route across the oversized world
        const vb = svg.viewBox.baseVal;
        const tip = progressPath.getPointAtLength(drawn);
        const mw = map.clientWidth;
        const mh = map.clientHeight;
        const px = (tip.x / vb.width) * mw * CAM_ZOOM;
        const py = (tip.y / vb.height) * mh * CAM_ZOOM;
        let tx = mw / 2 - px;
        let ty = mh / 2 - py;
        tx = Math.min(0, Math.max(mw - CAM_ZOOM * mw, tx));
        ty = Math.min(0, Math.max(mh - CAM_ZOOM * mh, ty));
        world.style.transform = `translate(${tx}px, ${ty}px)`;

        pins.forEach((pin, i) => {
          pin.classList.toggle('reached', progress >= stopFractions[i] - 0.05);
        });

        if (barFill) barFill.style.width = (progress * 100) + '%';
        if (flag) flag.classList.toggle('show', progress >= 0.94);

        // Which stop's panel is showing: split progress into 4 zones
        const stop = Math.min(3, Math.floor(progress * 4));
        if (stop !== activeStop) {
          activeStop = stop;
          panels.forEach((panel, i) => panel.classList.toggle('active', i === stop));
          pins.forEach((pin, i) => pin.classList.toggle('active', i === stop));
        }
      }

      function tick() {
        current += (target - current) * 0.1;
        if (Math.abs(target - current) < 0.0005) current = target;
        render(current);
        requestAnimationFrame(tick);
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        trailPath.style.strokeDashoffset = '0';
        progressPath.style.strokeDashoffset = String(HEAD_LEN - pathLength);
        pins.forEach(pin => pin.classList.add('reached'));
        panels[0].classList.add('active');
        if (intro) { intro.style.position = 'static'; intro.style.marginBottom = '1.5rem'; }
        const staticFlag = document.querySelector('.journey-flag');
        if (staticFlag) staticFlag.classList.add('show');
      } else {
        window.addEventListener('scroll', readScroll, { passive: true });
        window.addEventListener('resize', () => { placePins(); readScroll(); });
        readScroll();
        render(target);
        current = target;
        requestAnimationFrame(tick);
      }
    }
  </script>
</Layout>
